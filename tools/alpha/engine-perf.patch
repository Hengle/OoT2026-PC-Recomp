+}
+void hos_log_flush(void) { assert(!in_handler); flushes++; }
+void rx_close_asked(void) { assert(!in_handler); work++; now += rx_delay; }
+void hos_close_finish(void) {
+    assert(!in_handler && work == 1);
+    closes++;
