+    int polls = 0;
+    const auto poll_then_made = [&] { if (++polls == 3) m.pipeline.store(5); };
+    check(quick_pipe::take(m, true, 1000, budget, 13, none, none, destroy, now, poll_then_made) == quick_pipe::Got::kOther &&
