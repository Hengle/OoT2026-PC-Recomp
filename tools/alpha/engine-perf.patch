+    FakeEntry t;
+    t.quick.store(quick_pipe::kTried);
+    polls = 0;
+    check(quick_pipe::take(t, true, 1000, budget, 13, none, none, destroy, now, [&] { polls++; }) == quick_pipe::Got::kNothing &&
