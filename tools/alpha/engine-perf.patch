+                        '-I', str(ROOT / 'host/posix'), str(tmp / 'threads.cpp'), str(tmp / 'posix.o'), '-o', str(exe), '-ldl'],
+                       check=True)
+        env = {'PATH': '/usr/bin:/bin', 'ASAN_OPTIONS': 'detect_leaks=0'}
