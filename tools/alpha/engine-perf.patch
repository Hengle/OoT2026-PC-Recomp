+}
+static HANDLE CreateThread(void *security, size_t stack, DWORD (*fn)(void *), void *arg, DWORD flags, DWORD *id) {
+    assert(!security && !stack && !arg && !flags && !id);
+    assert(thread_calls < 2);
+    threads[thread_calls++] = fn;
