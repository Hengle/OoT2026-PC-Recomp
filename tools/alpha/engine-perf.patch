+    ten.vram_mb = 11264;
+    expect(choose(ten).tier == 3, "RTX 2080 Ti 11 GB: Balanced");
+    ten.vram_mb = 11776;
+    expect(choose(ten).tier == 3, "11.5 GB: Balanced");
+    ten.vram_mb = 12000;
+    expect(choose(ten).tier == 4, "a 12 GB card reporting 12,000 MB: High");
+    ten.vram_mb = 9216;
