index 0000000..9446ad3
--- /dev/null
+++ b/tests/test_hold_gpu.py
@@ -0,0 +1,83 @@
+"""Queues stopped at a wait are not made to go while a thread of the game's waits for the GPU (gpu/vk/hold_gpu.h).
+
+The order's watch thread (gpu/vk/vk_replay.cpp sync_watch) makes queues stopped for longer than hold_ms go past their
+waits: a game that polls for that work would wait for ever otherwise. But OoT's main thread waits once a frame for the GPU
+to finish the frame before (nvnSyncWait, its own queue's recorded work), and makes the signal the stopped queues wait for
+after that wait. When the GPU took longer than hold_ms (a load's uploads), the stopped queues were made to go and the frame
+was drawn with what the game had not written yet: the lit scene and Link dark for a frame (issue 366). Now they are held on
+while such a wait is under way and for hold_ms after it, up to a bound.
+
+The rule is compiled and run (tests/hold_gpu_test.cpp). And the source: wait() counts a thread in gpu_waiters only around its
+wait for its own queue's recorded work and only when its timeout is not a poll's; sync_watch reads the count, takes the
+later of the queues' stop and the last such wait as the hold's start, and asks the rule before it drains.
+
+python -I -B tests/test_hold_gpu.py [--cxx g++]
+"""
+import argparse
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, marker):
+    """From marker to the brace closing its first one"""
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def need(cond, why):
+    if not cond:
+        raise SystemExit("FAIL: " + why)
+
+
+def check_source():
+    replay = (ROOT / "gpu/vk/vk_replay.cpp").read_text(encoding="utf-8")
+    need('#include "hold_gpu.h"' in replay, "vk_replay.cpp no longer includes hold_gpu.h")
+
+    waiter = block(replay, "struct GpuWaiter {")
+    need("if (counted) gpu_waiters.fetch_add(1" in waiter and "if (counted) gpu_waiters.fetch_sub(1" in waiter,
+         "GpuWaiter must count a thread in and out, and only when told to")
+
+    wait = block(replay, "int wait(uint64_t f, uint64_t timeout_ns) {")
+    mine = block(wait, "if (mine) {")
+    need("GpuWaiter waiting(timeout_ns > 1000000);" in mine, "a poll must not count as a wait for the GPU")
+    need(mine.index("GpuWaiter waiting(") < mine.index("wait_recorded(f, timeout_ns, &ok)"),
+         "the thread is counted for the length of its wait for its own queue's recorded work")
+    need(wait.count("GpuWaiter") == 1, "only the wait for a queue's own recorded work counts: a wait that needs stopped work "
+                                       "is let on by sync_drain, not held for")
+
+    watch = block(replay, "void sync_watch() {")
+    need("gpu_waiters.load(" in watch and "if (gpu_wait) gpu_wait_seen = now;" in watch, "sync_watch no longer notes a wait for the GPU")
+    need("std::max(blocked_since, gpu_wait_seen)" in watch, "the hold after a wait starts at the later of the stop and the wait")
+    need("hold_gpu::choose(hold_gpu_on, gpu_wait," in watch, "sync_watch no longer asks the rule")
+    force = watch[watch.index("case hold_gpu::Choice::Force:"):]
+    need("drain(3);" in force and watch.count("drain(3);") == 1, "the stopped queues are made to go only where the rule says so")
+    need(watch.index("schedule();") < watch.index("hold_gpu::choose("), "the look at the queues comes before the hold's question")
+    need('getenv("RX_VK_HOLD_GPU_WAIT")' in watch and 'getenv("RX_VK_HOLD_GPU_MS")' in watch, "the switches are read in sync_watch")
+    need("(double)hold_ms()" in watch, "the bound is never under hold_ms")
+
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cxx", default="g++")
+    args = parser.parse_args()
+    check_source()
+    with tempfile.TemporaryDirectory(prefix="hold-gpu-") as tmp:
+        exe = Path(tmp) / "hold-gpu"
+        subprocess.run([args.cxx, "-std=c++20", "-Wall", "-Wextra", "-Werror", str(ROOT / "tests/hold_gpu_test.cpp"), "-o", str(exe)],
+                       check=True)
+        subprocess.run([str(exe)], check=True, timeout=60)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_import_reach.py b/tests/test_import_reach.py
new file mode 100644
index 0000000..bc68a57
--- /dev/null
+++ b/tests/test_import_reach.py
@@ -0,0 +1,101 @@
+"""Run vk_memory.cpp's actual scans down the import table with an import larger than 1 GiB behind a small one.
+
+pool_lookup's merge escape may leave an import above 1 GiB over smaller ones inside it ("left overlapping"), and the device
+allows imports up to max_import_size. The scans (pool_lookup's covering import and merge plan, bg_drain, prefetch_chunks,
+import_in_background, memory_note_gpu_write, memory_guest_imported) stopped 1 GiB below their address and missed such an
+import: the same bytes were imported twice. tests/import_reach_test.cpp records imports as ranges (no payload, no Vulkan, no
+game) and checks that every scan finds the large import, and that import_reach.h's bound counts exactly the live imports.
+The source check: the table has no way in or out but imported_add and imported_take, which keep that count, and no scan
+keeps the 1 GiB stop.
+
+python -I -B tests/test_import_reach.py --headers <Vulkan headers> [--cxx clang++] [--source <tree>]
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}", "--headers", "{vulkan_headers}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+# (tests/import_reach_test.cpp: one case each, each in a process of its own; "header" only where import_reach.h exists)
+CASES = ["lookup", "query", "note", "drain", "background", "prefetch", "retire"]
+ADD = "std::map<uint64_t, Pool>::iterator imported_add("
+TAKE = "std::map<uint64_t, Pool>::node_type imported_take("
+
+
+def block(text, marker):
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def excerpts(memory):
+    """The types and bodies the fixture runs, and whether the source keeps the live imports' reach"""
+    reach = ADD in memory
+    types = "\n".join(block(memory, marker) + ";" for marker in ("struct Pool {", "struct GuestPool {"))
+    code = ""
+    if reach:
+        start = memory.index("import_reach::Reach live_reach;")
+        code += memory[start:memory.index(";", start) + 1] + "\n" + block(memory, ADD) + "\n" + block(memory, TAKE) + "\n"
+    for marker in ("void retire_pool(std::map<uint64_t, Pool>::iterator it) {", "void bg_drain(", "void prefetch_chunks(",
+                   "void span_game_pools(", "Pool* pool_lookup(uint64_t guest, uint64_t size) {", "Pool* pool_of(",
+                   "bool import_in_background(", "void memory_note_gpu_write(", "int memory_guest_imported("):
+        code += block(memory, marker) + "\n"
+    return types, code, reach
+
+
+def source_problems(memory):
+    """Every way into or out of the table goes through the two helpers that keep live_reach, and no scan stops at 1 GiB"""
+    problems = []
+    if ADD not in memory or TAKE not in memory:
+        return ["vk_memory.cpp has no imported_add / imported_take: nothing counts the live imports' spans"]
+    rest = memory.replace(block(memory, ADD), "").replace(block(memory, TAKE), "")
+    for use in re.findall(r"\bimported\s*(?:\.\s*(?:emplace|emplace_hint|try_emplace|insert|insert_or_assign|extract|erase|"
+                          r"clear|merge|swap)\b|=[^=]|\[)", rest):
+        problems.append("vk_memory.cpp changes the import table outside imported_add / imported_take: " + use.strip())
+    if re.search(r"\.hi \+ \(1ull << 30\) <", memory):
+        problems.append("vk_memory.cpp still has a scan that stops 1 GiB below its address")
+    return problems
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--source", type=Path, default=ROOT, help="the tree whose vk_memory.cpp is run (default: this one)")
+    p.add_argument("--headers", type=Path, required=True)
+    p.add_argument("--cxx", default="clang++")
+    a = p.parse_args()
+    memory = (a.source / "gpu/vk/vk_memory.cpp").read_text(encoding="utf-8")
+    failed = ["source: " + problem for problem in source_problems(memory)]
+    for problem in failed:
+        print("FAIL", problem, flush=True)
+    types, code, reach = excerpts(memory)
+    fixture = (ROOT / "tests/import_reach_test.cpp").read_text(encoding="utf-8")
+    fixture = fixture.replace("/* TYPES */", types).replace("/* ACTUAL */", code)
+    with tempfile.TemporaryDirectory(prefix="import-reach-") as temp:
+        cpp = Path(temp) / "fixture.cpp"
+        cpp.write_text(fixture, encoding="utf-8")
+        exe = Path(temp) / "fixture.exe"
+        command = [a.cxx, "-std=c++20", "-O1", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function", "-Wno-unused-variable",
+                   "-Wno-missing-field-initializers", "-pthread", "-DHAVE_REACH=" + str(int(reach)),
+                   "-I" + str(a.headers), "-I" + str(a.source), str(cpp), "-o", str(exe)]
+        print("COMPILE:", " ".join(command), flush=True)
+        subprocess.run(command, check=True)
+        for case in CASES + (["header"] if reach else []):   # (one that fails does not hide the others)
+            print("RUN:", exe.name, case, flush=True)
+            if subprocess.run([str(exe), case], timeout=60).returncode:
+                failed.append(case)
+    if failed:
+        print("FAILED:", ", ".join(failed), flush=True)
+        sys.exit(1)
+    print("PASS: every scan finds the import above 1 GiB, and only imported_add / imported_take change the table", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_inline_write_order.py b/tests/test_inline_write_order.py
new file mode 100644
index 0000000..0d227e4
--- /dev/null
+++ b/tests/test_inline_write_order.py
@@ -0,0 +1,183 @@
+"""Overlapping inline GPU writes retain stream order, including with barrier deduplication.
+
+Compile the real gpu_write (with gpu_piece_bind and gpu_put), full_barrier, note_work and work wrappers with a recording spy.
+Unaligned writes are copied from the recording's stream, in order with the rest; only writes no import holds fall back to the
+CPU. No GPU or game files. Removing the write's barrier or its work count must fail.
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}", "--headers", "{vulkan_headers}"]
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(source, marker):
+    if source.count(marker) != 1:
+        raise SystemExit("source marker not found once: " + marker)
+    start = source.index(marker)
+    end = source.index("\n}\n", start) + 2
+    return source[start:end]
+
+
+PREFIX = r'''
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+#include <algorithm>
+#include <atomic>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+namespace mkwvk {
+const VkCommandBuffer cb = (VkCommandBuffer)(uintptr_t)7;
+const VkBuffer buffer = (VkBuffer)(uintptr_t)1;
+constexpr uint64_t base = 0x1000;
+std::vector<uint8_t> memory(131104);
+struct Range { uint64_t lo, hi; };
+std::vector<Range> pending;
+unsigned hazards, updates, copies, barriers, fallbacks;
+std::atomic<uint64_t> work_epoch{0};
+std::atomic<bool> par_active{false};
+std::atomic<int64_t> st_barriers_left_out{0}, st_barriers_made{0};
+VkCommandBuffer last_barrier_cmd{};
+uint64_t last_barrier_epoch = 0;
+bool env_on(const char*) { return false; }
+struct GprofSpan { GprofSpan(VkCommandBuffer, const char*) {} };
+struct BufferRef { VkBuffer buffer; uint64_t offset; explicit operator bool() const { return buffer != VK_NULL_HANDLE; } };
+BufferRef gpu_buffer_bind(uint64_t gpu, uint64_t n, bool write) {
+    assert(write);
+    return gpu >= base && gpu - base <= memory.size() && n <= memory.size() - (gpu - base)
+        ? BufferRef{buffer, gpu - base} : BufferRef{};
+}
+uint64_t gpu_pool_piece(uint64_t gpu, uint64_t n, bool& in_pool) {   // (one pool, [base, base + memory.size()))
+    in_pool = gpu >= base && gpu - base < memory.size();
+    return in_pool ? std::min<uint64_t>(n, memory.size() - (gpu - base)) : gpu < base ? std::min<uint64_t>(n, base - gpu) : n;
+}
+const VkBuffer stream = (VkBuffer)(uintptr_t)2;
+std::vector<uint8_t> stream_bytes(65536);
+uint64_t stream_used;
+bool stream_full;
+BufferRef stream_copy(const void* src, uint64_t n) {
+    const uint64_t at = (stream_used + 255) & ~255ull;
+    if (stream_full || !n || at + n > stream_bytes.size()) return {};
+    std::memcpy(stream_bytes.data() + at, src, n);
+    stream_used = at + n;
+    return {stream, at};
+}
+void guest_cpu_write(uint64_t, const void*, uint64_t) { ++fallbacks; }
+namespace rec {
+void rx_vkCmdPipelineBarrier2(VkCommandBuffer cmd, const VkDependencyInfo* d) {
+    assert(cmd == cb && d->memoryBarrierCount == 1);
+    const auto& b = *d->pMemoryBarriers;
+    if ((b.srcStageMask & VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT) &&
+        (b.dstStageMask & VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT) &&
+        (b.srcAccessMask & VK_ACCESS_2_MEMORY_WRITE_BIT) &&
+        (b.dstAccessMask & VK_ACCESS_2_MEMORY_WRITE_BIT)) pending.clear();
+    ++barriers;
+}
+void rx_vkCmdUpdateBuffer(VkCommandBuffer cmd, VkBuffer target, VkDeviceSize offset, VkDeviceSize n, const void* data) {
+    assert(cmd == cb && target == buffer && n <= 65536 && !(offset & 3) && !(n & 3));
+    assert(offset + n <= memory.size());
+    for (auto r : pending) if (offset < r.hi && r.lo < offset + n) ++hazards;
+    pending.push_back({offset, offset + n}); ++updates;
+    std::memcpy(memory.data() + offset, data, n);
+}
+void rx_vkCmdCopyBuffer(VkCommandBuffer cmd, VkBuffer src, VkBuffer target, uint32_t count, const VkBufferCopy* r) {
+    assert(cmd == cb && src == stream && target == buffer && count == 1);
+    assert(r->size && r->srcOffset + r->size <= stream_used && r->dstOffset + r->size <= memory.size());
+    for (auto p : pending) if (r->dstOffset < p.hi && p.lo < r->dstOffset + r->size) ++hazards;
+    pending.push_back({r->dstOffset, r->dstOffset + r->size}); ++copies;
+    std::memcpy(memory.data() + r->dstOffset, stream_bytes.data() + r->srcOffset, r->size);
+}
+}
+'''
+
+SUFFIX = r'''
+void reset() {
+    pending.clear(); hazards = updates = copies = barriers = fallbacks = 0; stream_used = 0; stream_full = false;
+    last_barrier_cmd = VK_NULL_HANDLE;
+    std::fill(memory.begin(), memory.end(), 0);
+}
+int check() {
+    std::vector<uint8_t> first(65536 + 16, 0x11), second(64, 0x22);
+    reset();
+    full_barrier(cb, "test"); full_barrier(cb, "test");
+    assert(barriers == 1);  // the test really exercises deduplication
+    gpu_write(cb, base + 64, first.data(), 16);
+    gpu_write(cb, base + 72, second.data(), 64);
+    const unsigned overlap = hazards;
+    assert(updates == 2 && !fallbacks);
+    for (unsigned i = 0; i < 8; ++i) assert(memory[64 + i] == 0x11);
+    for (unsigned i = 0; i < 64; ++i) assert(memory[72 + i] == 0x22);
+    reset();
+    gpu_write(cb, base, first.data(), first.size());
+    assert(updates == 2 && !hazards && std::equal(first.begin(), first.end(), memory.begin()));
+    gpu_write(cb, base + 65536, second.data(), 16);
+    const unsigned chunk_overlap = hazards;
+    assert(updates == 3 && std::equal(second.begin(), second.begin() + 16, memory.begin() + 65536));
+    reset();
+    gpu_write(cb, base + 1, first.data(), 4);
+    gpu_write(cb, base, second.data(), 3);
+    const unsigned copy_overlap = hazards;
+    assert(copies == 2 && !updates && !fallbacks && memory[0] == 0x22 && memory[2] == 0x22 && memory[3] == 0x11 && memory[4] == 0x11);
+    gpu_write(cb, 0, first.data(), 4);
+    gpu_write(cb, base, nullptr, 0);
+    stream_full = true;
+    gpu_write(cb, base + 1, first.data(), 4);
+    assert(fallbacks == 2 && copies == 2 && !updates);
+    if (overlap || chunk_overlap || copy_overlap) {
+        std::puts("FAIL: overlapping inline GPU writes are unordered"); return 1;
+    }
+    std::puts("PASS: overlapping writes, chunks, unaligned copies, fallbacks and barrier deduplication"); return 0;
+}
+}
+int main() { return mkwvk::check(); }
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cxx", default="clang++")
+    parser.add_argument("--headers", required=True, type=Path)
+    args = parser.parse_args()
+    vk = ROOT / "gpu/vk"
+    replay = (vk / "vk_replay.cpp").read_text(encoding="utf-8")
+    write = "".join(block(replay, marker) for marker in ("BufferRef gpu_piece_bind(", "bool gpu_put(", "void gpu_write("))
+    barrier = block((vk / "vk_texture.cpp").read_text(encoding="utf-8"), "void full_barrier(VkCommandBuffer cmd, const char* why)")
+    declarations = [line for line in (vk / "vk_texture.h").read_text(encoding="utf-8").splitlines()
+                    if line.startswith("void full_barrier(")]
+    if len(declarations) != 1:
+        raise SystemExit("vk_texture.h: full_barrier declaration not found once")
+    work = (vk / "vk_work.h").read_text(encoding="utf-8")
+    note = block(work, "inline void note_work()")
+    wrappers = []
+    for name in ("vkCmdPipelineBarrier2", "vkCmdUpdateBuffer", "vkCmdCopyBuffer"):
+        lines = [line for line in work.splitlines() if line.startswith("#define " + name + "(")]
+        if len(lines) != 1:
+            raise SystemExit("vk_work.h: wrapper not found once: " + name)
+        wrappers.append(lines[0])
+    source = PREFIX + note + "\n}\n" + "\n".join(wrappers) + "\nnamespace mkwvk {\n" + declarations[0] + "\n" + barrier + write + SUFFIX
+    variants = [("current", source, 0),
+                ("missing_barrier", source.replace("full_barrier(cmd);", ""), 1),
+                ("missing_work_count", source.replace("::mkwvk::note_work(), ::mkwvk::rec::rx_vkCmdUpdateBuffer", "::mkwvk::rec::rx_vkCmdUpdateBuffer"), 1)]
+    with tempfile.TemporaryDirectory(prefix="inline-write-") as tmp:
+        for name, text, expected in variants:
+            if name != "current" and text == source:
+                raise SystemExit("negative-control source moved: " + name)
+            cpp, exe = Path(tmp) / (name + ".cpp"), Path(tmp) / (name + (".exe" if os.name == "nt" else ""))
+            cpp.write_text(text, encoding="utf-8")
+            cmd = [args.cxx, "-std=c++20", "-O2", "-Wno-missing-field-initializers", "-I" + str(args.headers), str(cpp), "-o", str(exe)]
+            if os.name == "nt": cmd.append("-static")
+            subprocess.run(cmd, check=True, timeout=60)
+            result = subprocess.run([str(exe)], capture_output=True, text=True, timeout=10)
+            if result.returncode != expected or (expected and "overlapping inline GPU writes are unordered" not in result.stdout):
+                raise SystemExit(name + ": unexpected result\n" + result.stdout + result.stderr)
+            print(name + ": " + result.stdout.strip())
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_intel_compiler_gate.py b/tests/test_intel_compiler_gate.py
new file mode 100644
index 0000000..73e64eb
--- /dev/null
+++ b/tests/test_intel_compiler_gate.py
@@ -0,0 +1,156 @@
+"""Windows Intel's compiler is entered by one thread, and a fault creating a shader module leaves that program out.
+
+Intel UHD on Windows (igvk64) read address 0x170 during the first scene and the process ended. The stack was two frames
+in ocarina_reborn_vk.dll and then the thread start, and the log had no "driver faulted compiling" line, so the call was not
+inside guarded_graphics or guarded_compute. vkCreateShaderModule (translation, the movie and upscale helpers, a masked
+clear) and gpl_link's vkCreateGraphicsPipelines were not guarded, and graphics pipelines were still built side by side.
+NVIDIA, AMD, and Intel on other systems are not held. The Debug tab's Intel shader compiles row (Intel graphics on
+Windows only), or RX_VK_NO_INTEL_SERIAL over it, leaves them side by side. The renderer's own compute pipelines (ASTC, BC
+and unswizzle, write-back diff, reactive mask, FSR 3.1 and its inputs and interpolation, frame generation, the
+cooperative-matrix check) are guarded and held too: one of them built beside a worker's is the same two threads in it.
+
+python -I -B tests/test_intel_compiler_gate.py
+"""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, marker, start_at=0):
+    start = text.index(marker, start_at)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def brace_block(text, open_at):
+    """text[open_at] is '{'; return through its match, including the braces."""
+    end = open_at + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[open_at:end]
+
+
+def need(cond, why):
+    if not cond:
+        raise SystemExit("FAIL: " + why)
+
+
+def main():
+    internal = (ROOT / "gpu/vk/vk_internal.h").read_text(encoding="utf-8")
+    gate = block(internal, "struct IntelDriverGate {")
+    on = block(internal, "inline bool intel_gate_on() {")
+    need("#ifdef _WIN32" in on, "the lock is not limited to Windows")
+    need("!intel_compiles_side_by_side()" in on, "the Intel shader compiles row does not turn the lock off")
+    need("dev.props.vendorID == 0x8086" in on, "a vendor other than Intel takes the lock")
+    need("if (!intel_gate_on()) return;" in gate, "the lock is taken where it is off")
+    # (an ask that compiles nothing never waits behind a worker's compile: it is answered cold, HumanBean's review of #252)
+    need("std::try_to_lock" in gate and "busy = !hold.owns_lock();" in gate, "an ask waits for the lock")
+    menu = (ROOT / "gpu/vk/vk_menu.cpp").read_text(encoding="utf-8")
+    need("intel_side_by_side_chosen(opts.intel_compiles, dev.props.deviceID, dev.props.driverVersion)" in menu,
+         "the lock does not read the Intel shader compiles row")
+    need('if (const char* e = getenv("RX_VK_NO_INTEL_SERIAL")) env_override(&opts.intel_compiles, env_value_off(e) ? 2 : 1);'
+         in block(menu, "void menu_init() {"), "RX_VK_NO_INTEL_SERIAL does not turn the lock off")
+    need('{TAB_DEBUG, "Intel shader compiles", &opts.intel_compiles, 0, 2, 1, tx_intel_compiles,' in menu,
+         "no Intel shader compiles row")
+    shown = block(menu, "bool intel_compiler_row() {")
+    need("#ifdef _WIN32" in shown and "dev.props.vendorID == 0x8086" in shown, "the row shows where the lock never holds")
+    need("(v != &opts.intel_compiles || intel_compiler_row())" in block(menu, "bool row_shown(int i) {"),
+         "the row is not limited to Intel graphics on Windows")
+    need('(value == &opts.intel_compiles && getenv("RX_VK_NO_INTEL_SERIAL"))' in block(menu, "bool row_fixed(const int* value) {"),
+         "the row can be changed while RX_VK_NO_INTEL_SERIAL holds it")
+    need("std::unique_lock<std::mutex>(mu)" in gate, "the compiler is not entered by one thread")
+    draw = (ROOT / "gpu/vk/vk_draw.cpp").read_text(encoding="utf-8")
+    win = block(draw, "__declspec(noinline) VkResult guarded_shader_module(")
+    need("__try" in win and "vkCreateShaderModule" in win and "return (VkResult)-77;" in win,
+         "a fault in vkCreateShaderModule is not turned into a left-out program")
+    linux_at = draw.index("#else", draw.index("__declspec(noinline) VkResult guarded_shader_module("))
+    linux = block(draw, "VkResult guarded_shader_module(", linux_at)
+    need("sigsetjmp(fault_jmp, 1)" in linux and "vkCreateShaderModule" in linux,
+         "Linux does not guard vkCreateShaderModule")
+    for fn in ("VkResult cached_graphics(", "VkResult cached_compute("):
+        body = block(draw, fn)
+        need(body.index("IntelDriverGate") < body.index("create_cached"), fn + " compiles before it takes the lock")
+        need("IntelDriverGate gate(compiles_nothing(ci->flags));" in body and
+             "if (gate.busy) return intel_gate_busy();" in body, fn + " makes an ask wait for a compile")
+    graphics = block(draw, "VkResult graphics_with(")
+    need("return cached_graphics" in graphics, "the play-cache path takes the lock twice")
+    need("if (gate.busy) return intel_gate_busy();" in graphics, "graphics_with makes an ask wait for a compile")
+    # (an ask answered cold because the gate was busy is counted and logged: the pipeline may be in a cache all the same)
+    busy = block(draw, "VkResult intel_gate_busy()")
+    need("++st_intel_gate_busy" in busy and "logf(" in busy and "return VK_PIPELINE_COMPILE_REQUIRED;" in busy,
+         "an ask answered cold for a busy gate is not counted")
+    # (a dispatch's module, for a program read without its code: made on the replay thread when the gate is free, so a
+    # prepared pipeline is had at once, and left to the worker, not waited for, while a worker holds it. Its code is looked
