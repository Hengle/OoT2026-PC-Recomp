+def _clone(src, dst):
+    """A copy of src at dst, a copy-on-write clone where the file system has them"""
+    if hasattr(os, "O_BINARY") or not hasattr(os, "fork"):   # (Windows: a plain copy)
+        shutil.copyfile(src, dst)
+        return
