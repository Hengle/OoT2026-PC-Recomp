+/// IDs neither list names a card for (Navi 22's 0x73c3, its SR-IOV function 0x73ce). Untested ones go in with their chip
+inline bool task_mesh_fallback_default(uint32_t vendor, uint32_t device) {
+    if (vendor != 0x1002) return false;
+    switch (device) {
+    case 0x73a1:   // Navi 21: Radeon Pro V620
+    case 0x73a2:   // Navi 21: Radeon Pro W6900X
+    case 0x73a3:   // Navi 21: Radeon Pro W6800
+    case 0x73ab:   // Navi 21: Radeon Pro W6800X, W6800X Duo
+    case 0x73ae:   // Navi 21: Radeon Pro V620 MxGPU
+    case 0x73bf:   // Navi 21: RX 6800, 6800 XT, 6900 XT
+    case 0x73af:   // Navi 21: RX 6900 XT (XTXH boards)
+    case 0x73a5:   // Navi 21: RX 6950 XT
+    case 0x73df:   // Navi 22: RX 6700, 6700 XT, 6750 XT, 6750 GRE 12GB, 6700M, 6800M, 6850M XT
+    case 0x73e0:   // Navi 23: RX 6600M
+    case 0x73e1:   // Navi 23: Radeon Pro W6600M
+    case 0x73e3:   // Navi 23: Radeon Pro W6600
+    case 0x73ef:   // Navi 23: RX 6650 XT, 6650M, 6650M XT, 6700S, 6800S
+    case 0x73ff:   // Navi 23: RX 6600, 6600 XT, 6600 LE, 6600M, 6600S
+        return true;
+    default:
+        return false;
+    }
+}
+
 }  // namespace mesh_rule
diff --git a/gpu/vk/mirror_budget.h b/gpu/vk/mirror_budget.h
new file mode 100644
index 0000000..f727570
--- /dev/null
+++ b/gpu/vk/mirror_budget.h
@@ -0,0 +1,37 @@
+/* (hookshot) How much VRAM the game's memory pools may be mirrored in (vk_memory.cpp mirror_budget), by the card: Auto's rule, and
+   the cap on what a Quality preset asks. No Vulkan here. tests/test_mirror_budget.py */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace mkwvk::mirror_rule {
+
+/// What a card counts as small: 4.5 GB or less, where Auto gives an eighth
+inline bool small_card(uint64_t vram) { return vram && vram <= (4ull << 30) + (512ull << 20); }
+
+/// Auto's mirrors: a quarter of the card, at most 3 GB, and an eighth on a card of 4.5 GB or less (512 MB on 4 GB). A pool left out
+/// is read by the GPU over PCIe: on 8 GB cards, a 3070 or a 4060, that left the GPU at a few percent and the frame stuttering, and
+/// on a 6 GB RTX 3060 Laptop at an eighth (768 MB) or the Low preset's 512 MB, 30-32 GB of bound ranges went over PCIe every 600
+/// submits in Hyrule Field, the GPU's frame 27 ms against 19 at a quarter. 6 GB cards had an eighth because, with a quarter, the
+/// mirrors and the textures went past what the card has; the image blocks made at the start were then 896 MB of it held empty,
+/// and now they are made in the textures' pool, where the textures take them (vram_compact.h blocks_at_start). The mirrors are
+/// not squeezed when VRAM runs short (RX_VK_MIRROR_TIGHT is opt-in): the texture cache is. On that laptop at the Low preset's
+/// own render size the process then used 95% of what the driver allows (82% at 512 MB, 89% at 1024), the textures it holds
+/// about the same (1.56 GB against 1.62), 39 fps against 18, and 31 at 1024, where the pools are filled first come, first served
+inline uint64_t auto_bytes(uint64_t vram) {
+    if (!vram) return 3072ull << 20;
+    if (small_card(vram)) return vram / 8;
+    return std::min<uint64_t>(vram / 4, 3072ull << 20);
+}
+
+/// The mirrors a budget asks for, by the card. Set by a Quality preset (by_preset): never more than Auto gives the card, so a
+/// preset made for a larger card (Low's 1536 MB on a 4 GB one, preset_caps_memory lets Low's budgets through up to 6.75 GB) keeps
+/// a small card at Auto's. Chosen on the VRAM budget row itself: the player's, except on a small card, where it is capped at Auto's
+/// too (the row's 3.6 GB step on a 4 GB card was 512 MB before Low's mirrors went to 1536; its steps of 4.8 GB and more, past
+/// what such a card has, now keep 512 as well)
+inline uint64_t budget_bytes(uint64_t asked, bool by_preset, uint64_t vram) {
+    return vram && (by_preset || small_card(vram)) ? std::min(asked, auto_bytes(vram)) : asked;
+}
+
+}  // namespace mkwvk::mirror_rule
diff --git a/gpu/vk/quick_pipe.h b/gpu/vk/quick_pipe.h
new file mode 100644
index 0000000..6fb0bae
--- /dev/null
+++ b/gpu/vk/quick_pipe.h
@@ -0,0 +1,162 @@
+// (hookshot) Quick pipelines (RX_VK_QUICK_MS) and the brief pipeline wait (RX_VK_PIPE_WAIT_MS), for a draw whose full
+// pipeline build is not done (vk_draw.cpp, draw and quick_pipeline). Ported from Mako, by sharkiix (8292d363): AMD's
+// optimizer took 5-13 s a pipeline for Volvagia's intro, whose colour draws were left out (a black silhouette) or, waited
+// for, froze it. Only pipelines: a shader still translating is waited for as before
+// (https://github.com/NotRexed/Hookshot/pull/1573, RX_VK_TRANSLATE_WAIT_MS).
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+#include "translate_wait.h"   // (the same strict reading of a number of milliseconds)
+
+namespace quick_pipe {
+
+/// RX_VK_QUICK_MS's suggested value (off unless set, on every driver, until a run on AMD measures it): half a frame at 60 fps,
+/// the same bound as RX_VK_TRANSLATE_WAIT_MS's tested 8. A skippable draw's quick build only stands in for leaving it out, so
+/// its cost has to stay under a frame's: Mako's 1000 traded a missing draw for a hitch of up to a second. Where a quick build
+/// takes longer than 8 ms (tens of ms on AMD's proprietary driver), it means one quick build a frame on each recording thread,
+/// each a hitch of that build's length: the frame's first always runs (FrameBudget::fits) and nothing after it fits
+constexpr double kQuickSuggestedMs = 8;
+/// How long a draw that cannot be left out waits for a quick one another thread is making (a few ms as a rule), by the clock:
+/// a poll sleeps 1 ms, which is about 15 ms on Windows unless the timer resolution was raised, so a count of polls is no time
+constexpr double kOtherQuickWaitMs = 5000;
+
+/// A switch's milliseconds: its value when it reads as a number (0 or less: off), def when unset; a value that is not a
+/// number ("8ms", "off", "") is def too, with *bad set so that the caller says so in the log
+inline double read_ms(const char* env, double def, bool* bad) {
+    if (bad) *bad = false;
+    if (!env) return def;
+    double ms = 0;
+    if (!translate_wait::parse(env, ms)) {
+        if (bad) *bad = true;
+        return def;
+    }
+    return ms > 0 ? ms : 0;
+}
+/// RX_VK_QUICK_MS: each recording thread's quick builds a frame, in ms (unset or 0: none, the draw left out or waited for as
+/// before, on every driver)
+inline double quick_ms(const char* env, bool* bad) { return read_ms(env, 0, bad); }
+/// RX_VK_PIPE_WAIT_MS: each recording thread's waits a frame for skippable draws' pipelines, in ms (off unless set)
+inline double wait_ms(const char* env, bool* bad) { return read_ms(env, 0, bad); }
+/// RX_VK_TEST_SLOW_MS: a test that holds each full build that long, as AMD's optimizer on a cold cache (off unless set; at
+/// most a minute)
+inline int slow_ms(const char* env, bool* bad) {
+    const double ms = read_ms(env, 0, bad);
+    return ms > 60000 ? 60000 : (int)ms;
+}
+
+/// What is left of a budget in this frame, on one recording thread (a thread_local each)
+struct FrameBudget {
+    uint64_t frame = ~0ull;
+    double used = 0;
+    double build_ms = 0;   // (take's: the thread's last quick build, what the next one is expected to take; 0: none yet)
+    int builds = 0;        // (quick builds started this frame on this thread: not a cache answer, nor a busy gate's retry)
+    double left(uint64_t now, double total) {
+        if (now != frame) frame = now, used = 0, builds = 0;
+        return total - used;
+    }
+    /// take's: whether a quick build for a draw that may be left out is started now. One expected to fit in what is left, or
+    /// the frame's first build whatever it is expected to take (so that a build slower than the whole budget is still made,
+    /// one a frame): a frame runs past the budget by at most one build, not by every build started before it was spent. The
+    /// first is counted by builds started, not by time used: a busy gate's retry or a cache answer early in the frame takes
+    /// a little time but builds nothing, and must not keep the frame's one build from the draws after it
+    bool fits(uint64_t now, double total) {
+        const double l = left(now, total);
+        return l > 0 && (builds == 0 || build_ms <= l);
+    }
+    void started(uint64_t now, double total) {
+        left(now, total);
+        builds++;
+    }
+    void spend(double ms) { used += ms; }
+};
+
+/// A thread_local flag set for a scope and cleared on leaving it, by a throw too (run_guarded keeps a worker running after its
+/// job throws, and the flag would stay set for its next jobs)
+struct Raise {
+    bool& flag;
+    explicit Raise(bool& f) : flag(f) { flag = true; }
+    ~Raise() { flag = false; }
+    Raise(const Raise&) = delete;
+    Raise& operator=(const Raise&) = delete;
+};
+
+/// The quick state of an entry: none tried (or tried while the driver-fault gate was busy: tried again), one being made, one
+/// tried (made, or one that will not be made: the full build unoptimized already, a program the driver faulted on)
+enum : uint8_t { kNone = 0, kMaking = 1, kTried = 2 };
+enum class Got { kNothing, kCached, kQuick, kOther };
+
+/// The steps for a draw whose full pipeline is not ready and that has none to draw with (Entry: ready, pipeline and quick,
+/// atomics). Once an entry: the full one asked of the caches without compiling (ask), else one built now without the
+/// driver's optimizer and not into our pipeline cache (build); either set as the entry's pipeline, not ready, so the worker's
+/// full build replaces it. A handle that loses to the full one, which came first, is destroyed (no draw has seen it).
+/// must: a draw that cannot be left out: not held to the budget, and waits (poll) for a quick one another thread is making.
+/// The time taken comes off the budget either way. kOther: another thread's (or the full build) is there to draw with.
+/// ask and build set their bool when the driver-fault gate was busy (on AMD, one build of a program in the driver at a time:
+/// often the entry's own full build, queued a moment before): then nothing is built, and the entry is left kNone, to be
+/// tried again by a later draw. A retry is one non-blocking ask of the gate, and comes off the budget as any other
+template <class Entry, class Ask, class Build, class Destroy, class Now, class Poll>
+Got take(Entry& e, bool must, double budget_ms, FrameBudget& budget, uint64_t frame, Ask&& ask, Build&& build, Destroy&& destroy,
+         Now&& now_ms, Poll&& poll) {
+    using P = decltype(e.pipeline.load());
+    const auto there = [&] { return e.pipeline.load(std::memory_order_acquire) != P{}; };
+    if (budget_ms <= 0) return Got::kNothing;
+    if (!must && !budget.fits(frame, budget_ms)) return there() ? Got::kOther : Got::kNothing;
+    uint8_t none = kNone;
+    if (!e.quick.compare_exchange_strong(none, kMaking, std::memory_order_acq_rel)) {
+        const double from = must ? now_ms() : 0;
+        while (must && e.quick.load(std::memory_order_acquire) == kMaking && !there() &&
+               !e.ready.load(std::memory_order_acquire) && now_ms() - from < kOtherQuickWaitMs)
+            poll();
+        return there() ? Got::kOther : Got::kNothing;
+    }
+    // (the entry's state when this is over: kTried unless set below, so that a throw out of ask or build cannot leave it
+    // kMaking, with every draw of it that must wait polling for the whole kOtherQuickWaitMs)
+    struct Making {
+        decltype(e.quick)& quick;
+        uint8_t then = kTried;
+        ~Making() { quick.store(then, std::memory_order_release); }
+    } making{e.quick};
+    const double t0 = now_ms();
+    Got got = Got::kCached;
+    bool busy = false;
+    P pl = ask(busy);
+    double t1 = 0;
+    if (pl == P{} && !busy) {
+        got = Got::kQuick, t1 = now_ms(), pl = build(busy);
+        // (a build the gate let in, or one that will never be made: one that met the gate busy built nothing, and counted, it
+        // would keep the frame's one build from the draws after it for as long as its program is in the driver)
+        if (!busy) budget.started(frame, budget_ms);
+    }
+    const double t2 = now_ms();
+    if (got == Got::kQuick && pl != P{}) budget.build_ms = t2 - t1;   // (one made: a busy gate or a NOOPT one took no time)
+    budget.left(frame, budget_ms);
+    budget.spend(t2 - t0);
+    if (pl != P{}) {
+        P empty{};
+        if (!e.pipeline.compare_exchange_strong(empty, pl, std::memory_order_acq_rel)) destroy(pl), got = Got::kOther;
+    } else {
+        got = there() ? Got::kOther : Got::kNothing;
+    }
+    making.then = pl == P{} && busy ? kNone : kTried;
+    return got;
+}
+
+/// The brief wait: a skippable draw's queued full build moved to the queue's front (hurry) and waited for (wait, at most
+/// the ms it is given) while this frame's budget lasts. The build is not run on this thread: one started cannot be stopped,
+/// and on AMD's optimizer it took seconds. true: ready, draw it
+template <class Hurry, class Wait, class Now>
+bool brief(const std::atomic<bool>& ready, double budget_ms, FrameBudget& budget, uint64_t frame, Hurry&& hurry, Wait&& wait,
+           Now&& now_ms) {
+    if (ready.load(std::memory_order_acquire)) return true;
+    if (budget_ms <= 0) return false;
+    const double left = budget.left(frame, budget_ms);
+    if (left <= 0) return false;
+    const double t0 = now_ms();
+    hurry();
+    const bool ok = wait(left);
+    budget.spend(now_ms() - t0);
+    return ok;
+}
+
+}  // namespace quick_pipe
diff --git a/gpu/vk/sparse_mirror.h b/gpu/vk/sparse_mirror.h
new file mode 100644
index 0000000..49d38ee
--- /dev/null
+++ b/gpu/vk/sparse_mirror.h
@@ -0,0 +1,110 @@
+// (hookshot) A VRAM mirror's blocks that hold memory (vk_memory.cpp, RX_VK_MIRROR_SPARSE), apart from Vulkan so that
+// tests/test_sparse_mirror.py can run it.
+//
+// A pool's mirror covers its import's whole range, and an import is made by chunk around what was bound: the mirrors
+// held 243-533 MB of blocks outside every game pool (padding, and pools the game has let go; most after an area change),
+// of 1.1-1.6 GB, at DLAA 2560 x 1440 with 4 MB chunks. A sparse mirror gives memory only to the blocks a game pool is in.
+// The others read 0 and drop writes (residencyNonResidentStrict), and nothing of the game's reaches them: the page table
+// points their pages at guest memory, and a binding that reaches one where a game pool is is served from guest memory
+// until the block is given memory at the next submission (one whose blocks with none are all outside every game pool, a
+// guessed size run past a pool's end, is served from the mirror as it is). A block a game pool has left is given back
+// once the GPU is past it. On by default (RX_VK_MIRROR_SPARSE=0: whole mirrors).
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <iterator>
+#include <vector>
+
+namespace sparse_mirror {
+
+/// The blocks of a mirror of [lo, hi), `block` bytes each, that any of the game's pools [first, last) reaches (sorted by
+/// lo, as guest_pools; an earlier pool may reach past later ones): 1, the others 0. Into `live`, whose storage is kept
+template <class It>
+void live_blocks(uint64_t lo, uint64_t hi, uint64_t block, It first, It last, std::vector<uint8_t>& live) {
+    live.assign(hi > lo && block ? (size_t)((hi - lo + block - 1) / block) : 0, 0);
+    if (live.empty()) return;
+    // (every pool that starts below hi: one that starts far below lo can still reach into it)
+    const It end = std::upper_bound(first, last, hi - 1, [](uint64_t a, const auto& p) { return a < p.lo; });
+    for (It it = first; it != end; ++it) {
+        if (it->hi <= lo || it->hi <= it->lo) continue;
+        const uint64_t a = std::max(it->lo, lo) - lo, b = std::min(it->hi, hi) - lo;
+        for (uint64_t i = a / block; i < (b + block - 1) / block; i++) live[(size_t)i] = 1;
+    }
+}
+/// The same, returned
+template <class It>
+std::vector<uint8_t> live_blocks(uint64_t lo, uint64_t hi, uint64_t block, It first, It last) {
+    std::vector<uint8_t> live;
+    live_blocks(lo, hi, block, first, last, live);
+    return live;
+}
+
+/// The blocks [off, off + size) reaches: [*first, *end)
+inline void block_span(uint64_t off, uint64_t size, uint64_t block, size_t nblocks, size_t* first, size_t* end) {
+    *first = (size_t)std::min<uint64_t>(off / block, nblocks);
+    *end = size ? (size_t)std::min<uint64_t>((off + size + block - 1) / block, nblocks) : *first;
+}
+
+/// Runs of consecutive blocks whose state is `want` (get(i)): emit(first, count) each
+template <class Get, class Emit>
+void runs(size_t nblocks, Get get, bool want, Emit emit) {
+    for (size_t i = 0; i < nblocks;) {
+        if ((get(i) != 0) != want) {
+            i++;
+            continue;
+        }
+        size_t j = i + 1;
+        while (j < nblocks && (get(j) != 0) == want) j++;
+        emit(i, j - i);
+        i = j;
+    }
+}
+
+struct Copy { uint64_t src, dst, size; };
+
+/// The copies clipped to their parts whose source block (src_has(src offset)) and destination block (dst_has(dst
+/// offset)) both hold memory, `block` bytes each, cut where either changes. A copy from a block with none read 0 and
+/// put those zeros over what guest memory gave the destination; one into such a block was lost
+template <class SrcHas, class DstHas>
+std::vector<Copy> clip(const std::vector<Copy>& in, uint64_t block, SrcHas src_has, DstHas dst_has) {
+    std::vector<Copy> out;
+    for (const Copy& c : in) {
+        uint64_t at = 0;
+        while (at < c.size) {
+            const uint64_t s = c.src + at, d = c.dst + at;
+            // (to the next block end on either side)
+            const uint64_t step = std::min({c.size - at, block - s % block, block - d % block});
+            if (src_has(s) && dst_has(d)) {
+                if (!out.empty() && out.back().src + out.back().size == s && out.back().dst + out.back().size == d)
+                    out.back().size += step;
+                else
+                    out.push_back({s, d, step});
+            }
+            at += step;
+        }
+    }
+    return out;
+}
+
+/// The copies with every part whose source lies in one of `ranges` ([lo, hi) source offsets) cut out
+inline std::vector<Copy> cut_src(const std::vector<Copy>& in, const std::vector<std::pair<uint64_t, uint64_t>>& ranges) {
+    std::vector<Copy> cur = in;
+    for (const auto& [lo, hi] : ranges) {
+        if (hi <= lo) continue;
+        std::vector<Copy> next;
+        for (const Copy& c : cur) {
+            const uint64_t s = c.src, e = c.src + c.size;
+            if (e <= lo || s >= hi) {
+                next.push_back(c);
+                continue;
+            }
+            if (s < lo) next.push_back({s, c.dst, lo - s});
+            if (e > hi) next.push_back({hi, c.dst + (hi - s), e - hi});
+        }
+        cur.swap(next);
+    }
+    return cur;
+}
+
+} // namespace sparse_mirror
diff --git a/gpu/vk/threaded_rendering.h b/gpu/vk/threaded_rendering.h
new file mode 100644
index 0000000..127928b
--- /dev/null
+++ b/gpu/vk/threaded_rendering.h
@@ -0,0 +1,60 @@
+// (Ocarina Reborn) Threaded rendering: Auto, On or Off (OCR_THREADED_RENDERING unset, 1 or 0), as one rule every reader
+// shares: vk_replay.cpp threaded_rendering_on resolves it once, at the start; the replay
+// (vk_replay.cpp render_thread_mode), the recorder (vk_recorder.h mode_from_env), the host's present poll (HOS_OPT_RENDER_THREAD,
+// host/nvn_native.c) and the checks (tests/test_threaded_rendering.py compiles this file alone).
+//
+//   Off    the replay on the game's submitting thread, the recorder as RX_VK_RECORDER chooses it: as before the row
+//   On     the render thread (what RX_VK_ASYNC=1 gives: the replay on a thread of its own, the game a frame ahead of it) and
+//          the recorder thread (what RX_VK_RECORDER=thread gives) together, whatever the CPU
+//   Auto   (the default) decided from the logical processors the process may run on (its affinity mask, usable_cpus, not
+//          the PC's count): kAutoCpus or more, the render thread and the recorder thread; fewer, off. And off where the mode
+//          is not safe, whatever the CPU (the caller says so: the capture off, pools with no mirrors,
+//          RX_VK_LOW_SPEC, a frame dump, a benchmark replay). All of that behind kAutoEnabled, below, which is on:
+//          turned off, Auto is Off on every PC.
+//
+// The environment's switches stay the overrides they were, for testing: RX_VK_ASYNC set chooses the render thread and
+// RX_VK_RECORDER set the recorder, each over the row; unset, the row decides. Read once, at the start: a change of the row
+// takes effect at the next start (the replay's async_on and the recorder's mode are read once).
+#pragma once
+
+namespace mkwvk::threaded {
+
+enum { AUTO = 0, ON = 1, OFF = 2 };   // (the row's values, in V-Sync's order: Auto, On, Off)
+
+/// THE GATE: Auto's one switch. True: Auto follows the rule below (kAutoCpus, and off where unsafe), so a PC with kAutoCpus
+/// logical processors for the game runs the render thread and the recorder thread by default. False: Auto is Off
+/// everywhere and the row changes nobody's default; nothing else needs to change to turn Auto off again. Still open with
+/// it on: the game's large GPU-written tables (Hyrule Field's culling tables) can be read a frame old behind the game.
+constexpr bool kAutoEnabled = true;
+/// Auto's threshold: the logical processors the process may run on, from which it picks the render thread and the recorder
+/// thread (the game's own threads, the replay, the recorder and the parallel replay's workers beside one another)
+constexpr unsigned kAutoCpus = 12;
+
+enum class Why {
+    On,            // the row says On
+    Off,           // the row says Off
+    AutoGate,      // Auto, kAutoEnabled off: off everywhere
+    AutoUnsafe,    // Auto, and the mode is not safe on this run
+    AutoFewCpus,   // Auto, fewer than kAutoCpus logical processors (or their count unknown: 0)
+    AutoCpus,      // Auto, kAutoCpus or more: on
+};
+struct Choice {
+    bool on;   // (the render thread and the recorder thread, together)
+    Why why;
+};
+
+/// What Auto picks for `cpus` logical processors where the mode is safe, the gate aside
+constexpr bool auto_picks(unsigned cpus) { return cpus >= kAutoCpus; }
+
+/// The rule, from the row's value, the logical processors the process may run on and whether the mode is unsafe on this
+/// run: no environment, no clock, for the checks. `auto_enabled`: the gate (the checks pass it both ways). A value that is
+/// none of the row's is Auto
+constexpr Choice choose(int setting, unsigned cpus, bool unsafe, bool auto_enabled = kAutoEnabled) {
+    if (setting == ON) return {true, Why::On};
+    if (setting == OFF) return {false, Why::Off};
+    if (!auto_enabled) return {false, Why::AutoGate};
+    if (unsafe) return {false, Why::AutoUnsafe};
+    return auto_picks(cpus) ? Choice{true, Why::AutoCpus} : Choice{false, Why::AutoFewCpus};
+}
