+// held to at most 6 GB of it (vk_texture.cpp, the integrated budget: 4 GB with 32 GB of RAM), and it reads them through the
+// same memory as the CPU. A Ryzen 9 7900X's graphics are allowed 10232 MB with 32 GB of RAM, so the finer ones stayed RGBA8
+// there; in Kokiri Forest every large one as BC3 is 930 MB less decoded ASTC (2510 -> 1579 MB) at the same GPU time
+inline bool all(uint64_t allowed, bool integrated) {
+    return integrated || all_by_vram(allowed);
+}
+
 } // namespace astc_bc_policy
diff --git a/gpu/vk/auto_settings.h b/gpu/vk/auto_settings.h
new file mode 100644
index 0000000..87b92ef
--- /dev/null
+++ b/gpu/vk/auto_settings.h
@@ -0,0 +1,182 @@
+// The Quality preset "Auto (this PC)": the settings a PC starts with, from what it reports about itself (vk_menu.cpp,
+// menu_auto_for_gpu). tests/test_auto_settings.py
+//
+// One rule table, no list of GPU models: the facts a card reports reliably (its video memory, integrated or not, mesh shaders,
+// NVIDIA RTX or AMD RDNA 4 for the upscalers) and the screen's size. How fast the card is, which a model list would only guess,
+// is left to the measured tuning in play. Each choice says why, for the log line a bug report carries.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace auto_settings {
+
+enum Vendor : int { OTHER = 0, NVIDIA = 1, AMD = 2, INTEL = 3 };
+
+struct Hardware {
+    int vendor = OTHER;
+    bool integrated = false;
+    bool handheld = false;      // (a Steam Deck or another handheld PC: its own small screen and a shared memory budget)
+    bool mesh_native = true;    // (the card has mesh shaders, by its feature query; false: the fallback, the mesh programs as compute)
+    bool mesh_as_compute = false;   // (this run runs them as compute all the same: RX_VK_MESH_SHADERS=compute, or Linux AMD's
+                                    // Automatic, #2245. The card's tier is its own: not for the choice nor the fingerprint)
+    bool rtx = false;           // (an NVIDIA RTX card: DLSS's tensor cores)
+    bool rdna4 = false;         // (an AMD RDNA 4 card, RX 9000: FSR 4)
+    bool dlss_built = false;    // (the game was built with NVIDIA's DLSS SDK)
+    bool fsr4_built = false;    // (with AMD's FSR 4 runtime)
+    uint32_t vram_mb = 0;
+    uint32_t ram_mb = 0;        // (0: not known)
+    int threads = 0;            // (0: not known)
+    int screen_w = 0, screen_h = 0;   // (the desktop's size in pixels; 0: not known)
+    int refresh_hz = 0;
+};
+
+// What the profile sets. Indices are the menu's own: the Upscaler (upscaler_rows.h, ur::GAME...) and the Render resolution
+// (ur::kPercent's index). Not the Output resolution: it stays a new install's (hos_output_default) or the player's own. host/hos_main.c reads it
+// at boot, before the card is known, so a size chosen here only applied at the next start, and a new install's first close of
+// the menu asked to restart for it
+struct Choice {
+    int tier = 0;               // (the preset whose scaling holds: 1 Minimum ... 5 Ultra; VRAM budgets: texture_budget.h)
+    int upscaler = 0;
+    int resolution = 0;         // (0: the tier's own, as the preset sets it)
+    char why[480] = {};
+};
+
+// (upscaler_rows.h's, kept here so the rules compile on their own; the test checks they agree)
+enum { GAME = 0, DLSS = 1, FSR4 = 4 };
+enum { RES_QUALITY = 3, RES_PERFORMANCE = 4, RES_BALANCED = 5, RES_ULTRA_PERFORMANCE = 6 };
+
+// The Render resolution each preset sets (vk_menu.cpp apply_preset; tests/test_auto_settings.py checks they agree): the tier's
+// own, with the game's own upscaler
+constexpr int kTierResolution[] = {0, 4, 2, 1, 1, 1};
+
+// The memory tier: the presets' own steps (Minimum 4 GB, Low 6, Balanced 8, High 12, Ultra 16+). High from 11.5 GB: chosen when
+// High's 7.5 GB of textures and 2 GB of mirrors left a 10 or 11 GB card (RTX 3080, RX 6700, RTX 2080 Ti) too little for its
+// targets and the upscaler, and 12 GB cards report 12,000-12,288 MB. An integrated GPU, a handheld or a card without mesh shaders starts at
+// Minimum whatever its memory says: the memory it reports is shared with the system, or the fallback costs the frame more than
+// the memory saves. The tier sets the scaling rows only: the VRAM budgets are the card's own (texture_budget.h, mirror_budget.h),
+// the sizes these presets gave the cards they were for
+inline int tier_of(const Hardware& h) {
+    if (h.integrated || h.handheld || !h.mesh_native) return 1;
+    const uint32_t mb = h.vram_mb;
+    int t = mb <= 4608 ? 1 : mb <= 6656 ? 2 : mb <= 11776 ? 3 : mb <= 13312 ? 4 : 5;
+    // (under 12 GB of RAM the game's memory and the copies the driver keeps of its textures leave little: a lower tier's
+    // lighter rows, and texture_budget.h's smaller texture budget for such a PC)
+    if (h.ram_mb && h.ram_mb < 12288 && t > 2) t = 2;
+    return t;
+}
+
+inline void add(Choice& c, const char* text) {
+    const size_t n = std::strlen(c.why);
+    std::snprintf(c.why + n, sizeof c.why - n, "%s%s", n ? "; " : "", text);
+}
+
+inline Choice choose(const Hardware& h) {
+    Choice c;
+    c.tier = tier_of(h);
+    char b[160];
+    if (h.integrated) add(c, "integrated GPU: Minimum");
+    else if (h.handheld) add(c, "handheld: Minimum");
+    else if (!h.mesh_native) add(c, "no mesh shaders (the compute fallback): Minimum");
+    else {
+        std::snprintf(b, sizeof b, "%u MB of video memory: tier %d", (unsigned)h.vram_mb, c.tier);
+        add(c, b);
+        if (h.ram_mb && h.ram_mb < 12288 && c.tier == 2 && h.vram_mb > 6656) add(c, "under 12 GB of RAM: held at Low");
+        if (h.mesh_as_compute) add(c, "mesh shaders run as compute this run (the card has them: its tier all the same)");
+    }
+    // The upscaler: the one the card has hardware for, else the game's own (on every card, and what the presets were tuned
+    // on). At Minimum the game's own at its lowest share is the lightest
+    if (c.tier >= 2 && h.rtx && h.dlss_built) {
+        c.upscaler = DLSS;
+        c.resolution = c.tier == 2 ? RES_PERFORMANCE : c.tier == 3 ? RES_BALANCED : RES_QUALITY;
+        add(c, c.tier == 2 ? "NVIDIA RTX: DLSS Performance" : c.tier == 3 ? "NVIDIA RTX: DLSS Balanced" : "NVIDIA RTX: DLSS Quality");
+    } else if (c.tier >= 2 && h.rdna4 && h.fsr4_built) {
+        c.upscaler = FSR4;
+        c.resolution = c.tier == 2 ? RES_PERFORMANCE : c.tier == 3 ? RES_BALANCED : RES_QUALITY;
+        add(c, c.tier == 2 ? "AMD RDNA 4: FSR 4 Performance" : c.tier == 3 ? "AMD RDNA 4: FSR 4 Balanced" : "AMD RDNA 4: FSR 4 Quality");
+    } else {
+        add(c, h.rtx && !h.dlss_built ? "the game's own upscaler (this build has no DLSS)"
+               : h.rdna4 && !h.fsr4_built ? "the game's own upscaler (this build has no FSR 4)" : "the game's own upscaler");
+    }
+    // (an integrated GPU beside 4 threads or fewer: Minimum's 50% was 60-220 ms of GPU time a frame in Kokiri Forest on an
+    // i3-1115G4's UHD Graphics (2 cores, 4 threads, 16 GB), 3-5 fps. A third of each side is a ninth of the pixels)
+    if (h.integrated && h.threads > 0 && h.threads <= 4) {
+        c.resolution = RES_ULTRA_PERFORMANCE;
+        add(c, "4 threads or fewer: the game's own at 33%");
+    }
+    return c;
+}
+
+// The Render resolution for the upscaler that runs (the engine, upscaler_rows.h engine), unsnapped; 0: as it is. The build having
+// DLSS or FSR 4 does not say this PC runs it (an old driver, no NGX libraries, #1748): when the game's own runs instead, it draws
+// at DLSS's share, under what the tier sets for it, so it goes back to the tier's own; and to the choice's when the chosen one
+// runs again. Only between those two: a step the tuning made is left alone. chosen: the choice's Render resolution as the menu
+// set it (snapped to its upscaler)
+inline int resolution_for(const Choice& c, int engine, int resolution, int chosen) {
+    if (c.tier < 1 || c.upscaler == GAME || !c.resolution) return 0;
+    const int own = kTierResolution[c.tier];
+    if (engine != c.upscaler && resolution == chosen && own != chosen) return own;
+    if (engine == c.upscaler && resolution == own && own != chosen) return c.resolution;
+    return 0;
+}
+
+// The fingerprint the options file keeps (auto_for=): the choice is made again when the hardware it was made for changes
+inline uint64_t fingerprint(const Hardware& h, uint32_t vendor_id, uint32_t device_id) {
+    uint64_t f = 1469598103934665603ull;
+    const uint64_t parts[] = {vendor_id, device_id, h.vram_mb >> 8, (uint64_t)h.screen_w, (uint64_t)h.screen_h,
+                              (uint64_t)h.dlss_built, (uint64_t)h.fsr4_built, (uint64_t)h.mesh_native};
+    for (uint64_t p : parts) f = (f ^ p) * 1099511628211ull;
+    return f;
+}
+
+// The measured tuning in play: the render resolution moved toward what this PC holds at its frame rate cap. Each window is the
+// replay's 120 presents (vk_replay.cpp): the GPU's time a frame, the draws a frame and the frame rate. Only windows of play count
+// (150 draws a frame or more, as the control bridge's "play"; menus and loading screens draw fewer). After kWindows of them,
+// their middle values decide, lowering the picture only where frames are missed and raising it only with room to spare:
+// - frames missed (under 95% of the cap) and the GPU over 90% of the cap's frame time: one step smaller (lighter). A PC that
+//   holds its cap keeps its picture however busy the GPU is
+// - frames missed with the GPU under 90% of the cap's frame time and idle for a quarter of the frame shown or more: the CPU
+//   holds it (the game's threads, the replay), and a smaller picture would not help: done for this run, nothing changed. Not
+//   for good (the menu writes no auto_tuned): early in play pipelines may still be compiling and textures streaming in
+// - the cap held and the GPU under 50% of its frame time: one step larger, past what the profile chose (the memory tier sets
+//   the budgets, not how fast the GPU is) up to the best mode that still upscales (best_step: Quality, or the game's own at
+//   100%), never native (DLAA, FSR 4's native AA), whose larger images 8 GB cards ran out of memory with
+// - else: done
+// At most kMaxSteps changes in all; a step down is never followed by a step up (no seesaw). Then done until the hardware changes.
+// steps and went_down are kept in the options file (auto_steps=), so both hold across restarts too
+constexpr int kWindows = 8;
+constexpr int kMaxSteps = 2;
+enum Verdict : int { WAIT = 0, KEEP = 1, CPU_BOUND = 2, LIGHTER = 3, HEAVIER = 4 };
+struct Tuning {
+    float gpu_ms[kWindows] = {}, fps[kWindows] = {};
+    int n = 0;          // (play windows gathered since the last change)
+    int steps = 0;
+    bool went_down = false;
+    bool done = false;
+    float gpu_mid = 0, fps_mid = 0;   // (the middle values the last verdict was made on: for the log)
+};
+inline float middle(float* v, int n) {   // (the median; sorts v)
+    for (int i = 1; i < n; i++)
+        for (int j = i; j > 0 && v[j] < v[j - 1]; j--) { const float t = v[j]; v[j] = v[j - 1]; v[j - 1] = t; }
+    return n % 2 ? v[n / 2] : (v[n / 2 - 1] + v[n / 2]) / 2;
+}
+// The largest Render resolution the tuning raises to for an upscaler (upscaler_rows.h's): Quality (67%) for DLSS, FSR 3.1 and
+// FSR 4, 100% for the game's own and Off
+inline int best_step(int upscaler) { return upscaler == 1 || upscaler == 3 || upscaler == 4 ? RES_QUALITY : 1; }
+// One window: WAIT while gathering, else the verdict. cap_fps: the cap the game runs to (the display's refresh when uncapped);
+// can_lighter, can_heavier: whether the render resolution has a step that way (heavier: not past best_step)
+inline Verdict tune(Tuning& t, float gpu_ms, float draws, float fps, float cap_fps, bool can_lighter, bool can_heavier) {
+    if (t.done || draws < 150 || !(gpu_ms > 0) || !(fps > 0) || !(cap_fps > 0)) return WAIT;
+    t.gpu_ms[t.n] = gpu_ms, t.fps[t.n] = fps;
+    if (++t.n < kWindows) return WAIT;
+    const float g = middle(t.gpu_ms, t.n), f = middle(t.fps, t.n), budget = 1000.0f / cap_fps;
+    t.n = 0, t.gpu_mid = g, t.fps_mid = f;
+    const bool missed = f < cap_fps * 0.95f;
+    if (missed && g > 0.9f * budget && can_lighter && t.steps < kMaxSteps) return t.steps++, t.went_down = true, LIGHTER;
+    if (missed && g < 0.9f * budget && g < 0.75f * (1000.0f / f)) return t.done = true, CPU_BOUND;
+    if (!missed && g < 0.5f * budget && can_heavier && !t.went_down && t.steps < kMaxSteps) return t.steps++, HEAVIER;
+    t.done = true;
+    return KEEP;
+}
+
+} // namespace auto_settings
diff --git a/gpu/vk/commit_room.h b/gpu/vk/commit_room.h
new file mode 100644
index 0000000..48856f4
--- /dev/null
+++ b/gpu/vk/commit_room.h
@@ -0,0 +1,90 @@
+// (hookshot) The commit Windows still has room for, apart from Windows so that tests/test_commit_room.py can run it.
+//
+// The textures' budget gives commit back below a reserve under Windows' commit limit (vk_texture.cpp's commit rule). That limit
+// is RAM plus the page files as they are now, and a page file Windows manages grows when the commit nears it: the limit read
+// at one moment is not the one a commit fails at. A 32 GB PC whose page file was 2 GB at the start played 90 minutes with
+// 0.3 to 2.5 GB left under the limit of the moment while Windows raised that limit by more than 12 GB and refused no commit;
+// the rule took 292,526 textures out of the cache in that time, down to a budget of 0, and the player saw the textures go
+// black and come back. What the page files can still grow by counts as room.
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace commit_room {
+
+/// One page file, in bytes: its size now, the most Windows lets it reach, and its drive's letter ('C'; 0: not known)
+struct PageFile {
+    uint64_t size, max_size;
+    char drive;
+};
+
+/// What the page files can still grow by: each up to its maximum, and those of one drive together no further than the drive
+/// has free (drive_free: bytes free on a drive by its letter; 0 where it cannot be read). A file of an unknown drive counts
+/// for nothing, as a file at its maximum does: with only such files the room is what is left under the limit now
+template <typename DriveFree>
+inline uint64_t growth(const PageFile* files, size_t n, DriveFree drive_free) {
+    uint64_t left[26];
+    bool read[26] = {};
+    uint64_t sum = 0;
+    for (size_t i = 0; i < n; i++) {
+        const PageFile& f = files[i];
+        if (f.drive < 'A' || f.drive > 'Z' || f.max_size <= f.size) continue;
+        const int d = f.drive - 'A';
+        if (!read[d]) read[d] = true, left[d] = drive_free(f.drive);
+        const uint64_t g = std::min(f.max_size - f.size, left[d]);
+        left[d] -= g;
+        sum = sum > UINT64_MAX - g ? UINT64_MAX : sum + g;
+    }
+    return sum;
+}
+
+/// The commit left before the limit Windows can reach: what is left under the limit now, and what the page files can grow by
+inline uint64_t headroom(uint64_t avail, uint64_t grow) { return avail > UINT64_MAX - grow ? UINT64_MAX : avail + grow; }
+
+/// Whether the growth is worth reading: only below the reserve, where the commit rule would act. Above it the answer is the same
+inline bool wants_growth(uint64_t avail, uint64_t reserve, bool counted) { return counted && reserve && avail < reserve; }
+
+/// A record of NtQuerySystemInformation's SystemPageFileInformationEx (0x90) on 64-bit Windows: the sizes in pages, the name
+/// a UNICODE_STRING (bytes, then the address of its UTF-16 text). 0x28 bytes
+struct Record {
+    uint32_t next, total, in_use, peak;
+    uint16_t name_bytes, name_room;
+    uint32_t pad;
+    uint64_t name;
+    uint32_t min_size, max_size;
+};
+static_assert(sizeof(Record) == 0x28 && offsetof(Record, name) == 0x18 && offsetof(Record, max_size) == 0x24);
+
+/// The drive letter in a page file's name ("\??\C:\pagefile.sys": the first letter with a colon after it), upper case; 0: none
+inline char drive_of(const char16_t* name, size_t chars) {
+    for (size_t i = 0; i + 1 < chars; i++) {
+        const char16_t c = name[i];
+        if (name[i + 1] != u':') continue;
+        if (c >= u'A' && c <= u'Z') return (char)c;
+        if (c >= u'a' && c <= u'z') return (char)(c - u'a' + u'A');
+    }
+    return 0;
+}
+
+/// The page files in what that query wrote (len bytes at buf, which stays at the address the query wrote it to: the names are
+/// addresses into it), at most cap of them. A record or a name that does not lie inside buf ends the list or loses its drive
+inline size_t page_files(const unsigned char* buf, size_t len, uint64_t page, PageFile* out, size_t cap) {
+    size_t n = 0, at = 0;
+    while (n < cap && at <= len && len - at >= sizeof(Record)) {
+        Record r;
+        std::memcpy(&r, buf + at, sizeof r);
+        PageFile f{(uint64_t)r.total * page, (uint64_t)r.max_size * page, 0};
+        const uint64_t lo = (uint64_t)(uintptr_t)buf, hi = lo + len;
+        if (r.name >= lo && r.name <= hi && r.name_bytes <= hi - r.name && r.name % alignof(char16_t) == 0)
+            f.drive = drive_of((const char16_t*)(uintptr_t)r.name, r.name_bytes / sizeof(char16_t));
+        out[n++] = f;
+        if (!r.next || r.next < sizeof(Record) || r.next > len - at) break;
+        at += r.next;
+    }
+    return n;
+}
+
+}  // namespace commit_room
diff --git a/gpu/vk/dlss_actor.h b/gpu/vk/dlss_actor.h
index d95b94f..4d22823 100644
--- a/gpu/vk/dlss_actor.h
+++ b/gpu/vk/dlss_actor.h
@@ -3,6 +3,7 @@
 #pragma once
 
 #include <algorithm>
+#include <cmath>
 #include <cstdint>
 #include <cstring>
 #include <vector>
@@ -21,6 +22,100 @@ inline uint64_t key(uint64_t vbuf, uint64_t ibuf, int count, int base_vertex, ui
 }
 inline bool same_model(uint64_t a, uint64_t b) { return a >> 8 == b >> 8; }
 
+/// (hookshot) A copy of a model, for pair_by_place: where it is (place_of) and which draw of the model it is (its n-th)
+struct Placed {
+    float place[3];
+    int nth;
+};
+
+/// (hookshot) Which of the frame before's copies of a model each of this frame's copies is, by place: for each of `now`, an
+/// index into `then`, or -1 (none: the camera's motion then, never another copy's). All copies are paired at once, the
+/// nearest pairs first, and never further apart than `reach` (in world units, moved between the two frames). On a tie (the
+/// same geometry drawn twice for one object, both at one place) the same n-th draw pairs first. The pairing by draw order
+/// (each copy with the frame before's same n-th) is kept when it is as good: every pair of it within the reach, and either
+/// more copies paired than nearest first, or as many with the distance moved over all of them no longer (a total over
+/// fewer pairs is not comparable: two copies 0.9 apart both moving 0.5 pair one by nearest first, at 0.4, and two by
+/// draw order, at 0.5 each, which is right). So the reach is all that keeps draw order from pairing a row of copies each
+/// with its neighbour (a stone's frame before the next one's, after a stone changes model): it must stay under the copies'
+/// spacing, as actor_motion keeps it (2 at the most, the Gossip Stones stand 2.3 apart).
+/// By draw order alone, the four Gossip Stones drawn in another order took each other's places as their own frame before,
+/// and DLSS Frame Generation drew a stone part way to the next one. Taking the nearest free copy in draw order also failed:
+/// in a row of evenly spaced stones, a stone whose own frame before is missing (not drawn, or drawn by the other model the
+/// game uses for them) took its neighbour's. Nearest first alone fails the other way: two copies 0.6 apart that both move
+/// 0.35 have the first one's new place nearest the second's old one, and nearest first swaps them where draw order (0.35
+/// each, against 0.25 and 0.95) was right
+inline std::vector<int> pair_by_place(const std::vector<Placed>& now, const std::vector<Placed>& then, float reach) {
+    struct Candidate {
+        double d;     // (squared)
+        bool other;   // (not the same n-th: on a tie at one place, the same n-th pairs first)
+        int i, j;
+    };
+    std::vector<Candidate> candidates;
+    const double r2 = (double)reach * (double)reach;
+    for (int i = 0; i < (int)now.size(); i++)
+        for (int j = 0; j < (int)then.size(); j++) {
+            double d = 0.0;
+            for (int c = 0; c < 3; c++) {
+                const double e = (double)now[i].place[c] - (double)then[j].place[c];
+                d += e * e;
+            }
+            if (std::isfinite(d) && d <= r2) candidates.push_back({d, now[i].nth != then[j].nth, i, j});
+        }
+    std::sort(candidates.begin(), candidates.end(), [](const Candidate& a, const Candidate& b) {
+        return a.d != b.d ? a.d < b.d : a.other != b.other ? !a.other : a.i != b.i ? a.i < b.i : a.j < b.j;
+    });
+    std::vector<int> pairs(now.size(), -1);
+    std::vector<char> taken(then.size(), 0);
+    const auto distance = [&](int i, int j) {
+        double d = 0.0;
+        for (int c = 0; c < 3; c++) {
+            const double e = (double)now[i].place[c] - (double)then[j].place[c];
+            d += e * e;
+        }
+        return std::sqrt(d);
+    };
+    int nearest_n = 0;
+    double nearest_total = 0.0;
+    for (const Candidate& c : candidates)
+        if (pairs[c.i] < 0 && !taken[c.j])
+            pairs[c.i] = c.j, taken[c.j] = 1, nearest_n++, nearest_total += distance(c.i, c.j);
+    // (by draw order: kept when it is no worse, as above. A copy without a same n-th then is left unpaired by it)
+    std::vector<int> by_order(now.size(), -1);
+    std::vector<char> used(then.size(), 0);
+    int order_n = 0;
+    double order_total = 0.0;
+    for (int i = 0; i < (int)now.size(); i++) {
+        int j = 0;
+        while (j < (int)then.size() && then[j].nth != now[i].nth) j++;
+        if (j == (int)then.size()) continue;
+        const double d = distance(i, j);
+        if (used[j] || !(d <= (double)reach)) return pairs;   // (not within the reach: nearest first; NaN fails here too)
+        by_order[i] = j, used[j] = 1, order_n++, order_total += d;
+    }
+    if (order_n > nearest_n || (order_n == nearest_n && order_total <= nearest_total + 1e-6)) return by_order;
+    return pairs;
+}
+
+/// (hookshot) Where a skinned draw is, to tell copies of one model apart: its origin plus the mean of its bones'
+/// translations. pose: the origin (12 bytes, then 4 of padding), then nbones 3 x 4 row-major matrices, as the actor pass
+/// keeps it (world = sum(w B p) + origin). A model placed by its origin differs there; copies placed by their bones at one
+/// origin differ in the bones (the game's copies of one model share an origin on a grid of 10 units, the Gossip Stones
+/// among them); the sum is the place either way. Bones with a translation that is not finite are left out
+inline void place_of(const uint8_t* pose, uint32_t nbones, float place[3]) {
+    float o[3];
+    std::memcpy(o, pose, sizeof o);
+    double t[3] = {0.0, 0.0, 0.0};
+    uint32_t used = 0;
