+static LRESULT DispatchMessageW(const MSG *msg) { (void)msg; return 0; }
+static HANDLE CreateEventW(void *security, BOOL manual, BOOL initial, const wchar_t *name) {
+    assert(!security && !initial && !name);
+    event_calls++;
