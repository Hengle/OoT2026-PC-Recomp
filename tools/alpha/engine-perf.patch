+
+}  // namespace
+
+int main(int argc, char** argv) {
+    dev.driver_id = argc > 1 && !std::strcmp(argv[1], "amd") ? VK_DRIVER_ID_AMD_PROPRIETARY : VK_DRIVER_ID_NVIDIA_PROPRIETARY;
