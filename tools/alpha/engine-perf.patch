diff --git a/tests/test_fastfp_fma.py b/tests/test_fastfp_fma.py
new file mode 100644
index 0000000..34a7430
--- /dev/null
+++ b/tests/test_fastfp_fma.py
@@ -0,0 +1,81 @@
+"""(hookshot) The fast float regions' ops (nx2/fastfp.py's FASTFP_HEADER: the FMA3 multiply-add, the multiply, divide,
+add and subtract, and the vector add, subtract and multiply) against the exact bodies, game-free.
+
+Builds what the real build builds (a64_fpx.h, a64_suyu.h, a64_suyu.c, through tests/test_fpx_sticky.py's generate) plus
+FASTFP_HEADER, and compiles tests/fastfp_fma_test.c at -march=x86-64-v3 with the build's FP flags. The op runs alone
+inside the regions' MXCSR window (a64_ff_begin / a64_ff_end); a result the window keeps must equal recomp_fpe_fma32's,
+value and FPSR, under FPCR.FZ off and on and FPSR with IXC only or every flag set:
+  - an edge list: 0 * inf + a quiet NaN (x86: the NaN, no flag; Arm: the default NaN, IOC), a product rounded up to the
+    smallest normal (x86 detects tininess after rounding, Arm before: UFC, and a zero under FZ), a subnormal addend or
+    operand, an exact cancellation, overflow, quiet NaN operands;
+  - 2M random triples: zeros, subnormals, inf, NaN, the extreme normals, products near the underflow and overflow edges
+    (a quarter of them rounding near 2^-126), cancellations.
+
+It has teeth (each by hand, then restored, 2026-11-11):
+  - the NaN test dropped (`m > 0x7f800000u ||` removed): 0 * inf + qNaN kept with the addend's NaN and no IOC;
+  - the smallest-normal test dropped (`|| m == 0x00800000u` removed): UFC missing, and 2^-126 where FZ wants a zero;
+  - the addend's place changed (vfmadd231ss made vfmadd213ss: z * a + b): wrong values.
+  (a and b swapped is not caught, and need not be: the product commutes, and a NaN result always falls back.)
+
+Every other op is held to the same. Before a64_ff_guard_, the multiply kept 15348 of 8M results that differ from
+Arm's: a product rounded up to 2^-126 (UFC missing, and under FZ 2^-126 where Arm gives a zero), and under FZ a
+subnormal times a quiet NaN (Arm flushes the subnormal and sets IDC; x86 raises no denormal flag next to a NaN).
+
+    python -I -B tests/test_fastfp_fma.py [--cc clang] [--cxx clang++]
+"""
+import argparse
+import os
+import platform
+import sys
+import tempfile
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+KIT = os.path.join(ROOT, "third_party", "a64-kit")
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import test_fpx_sticky as S  # noqa: E402
+
+N, SEED = 2000000, 20261111
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--cc")
+    p.add_argument("--cxx")
+    a = p.parse_args()
+    if platform.machine().lower() not in ("x86_64", "amd64"):
+        print("fastfp fma: skipped (not an x86-64 host)")
+        return
+    cc = S.compiler(a.cc, "CC", ("clang", "gcc", "cc"), "clang")
+    cxx = S.compiler(a.cxx, "CXX", ("clang++", "g++", "c++"), "clang++")
+    if not cc or not cxx:
+        print("fastfp fma: skipped (no C/C++ compiler)")
+        return
+    t0 = time.time()
+    with tempfile.TemporaryDirectory(prefix="hookshot-fastfp-fma-") as tmp:
+        S.generate(cxx, tmp, S.target_flags(cxx, tmp))
+        sys.path.insert(0, os.path.join(ROOT, "nx2"))
+        import fastfp
+        with open(os.path.join(tmp, "a64_fastfp.h"), "w", newline="\n") as f:
+            f.write(fastfp.FASTFP_HEADER)
+        exe = os.path.join(tmp, "fastfp_fma_test.exe")
+        S.build([cc] + S.target_flags(cc, tmp) + ["-march=x86-64-v3"] + S.FLAGS +
+                ["-D_CRT_SECURE_NO_WARNINGS", "-I" + os.path.join(KIT, "rt"), "-I" + tmp,
+                 os.path.join(ROOT, "tests", "fastfp_fma_test.c"), os.path.join(tmp, "a64_suyu.c"), "-o", exe],
+                "the driver")
+        failed = []
+        for op in ("fma", "mul", "div", "add", "sub", "vmul", "vadd", "vsub"):
+            r = S.run([exe, op, str(N if op in ("fma", "mul") else N // 4), str(SEED)])
+            print(r.stdout.rstrip())
+            if r.returncode == 3:
+                print("fastfp fma: skipped (this CPU is not x86-64-v3)")
+                return
+            if r.returncode:
+                failed.append(op)
+    if failed:
+        raise SystemExit("fastfp fma: FAIL (%s) in %.1f s" % (", ".join(failed), time.time() - t0))
+    print("fastfp fma: pass in %.1f s" % (time.time() - t0))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_fastfp_override.py b/tests/test_fastfp_override.py
new file mode 100644
index 0000000..febb024
--- /dev/null
+++ b/tests/test_fastfp_override.py
@@ -0,0 +1,176 @@
+"""(hookshot) nx2/fastfp.py's copy of a64-kit's Lifter.emit_function stays the kit's, apart from its fast float lines.
+
+The fast float regions (A64_FASTFP) gather their runs inside the per-instruction loop of the kit's emit_function. The kit
+stays as it was imported (CONTRIBUTING.md), so nx2/fastfp.py replaces the method with a copy that has those lines added, each
+tagged "# (fastfp)". This checks, game-free and without a compiler:
+  - the copy with its tagged lines taken out is the kit's method, line for line (dedented one level: a module function there),
+    so a change to the kit's emit_function that the copy did not follow fails here;
+  - the copy names the a64-kit tree it was taken from (KIT_TREE), and that is still the tree-sha256 in
+    third_party/a64-kit/PROVENANCE.md: an a64-kit refresh fails here until the copy is compared with it again and KIT_TREE
+    moved on;
+  - run over a made-up function (hand-written instruction texts on a lifter with no translator), with A64_FASTFP=0 the copy
+    writes exactly what the kit's method writes, with comments and without; with it on, a run of 8 vector multiplies is one
+    region (its fast and exact copies, counted in the stats), a label in the middle of the run cuts it (the labelled
+    instruction joins neither side), a run of 7 stays as
+    the kit writes it, and an instruction with code after it (a game patch) is not joined;
+  - nx2/lift.py installs it before nx2/lift_fixes.py's wrapper, so lift_fixes and poll wrap the copy, not the other way round.
+
+It has teeth (each by hand, then restored, 2026-11-15): a line of the copy changed without the tag, the tag dropped from an
+added line, KIT_TREE one digit off, and fastfp.install() moved after lift_fixes.install() each fail it.
+
+    python -I -B tests/test_fastfp_override.py
+"""
+import ast
+import collections
+import os
+import re
+import sys
+import textwrap
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+KIT = os.path.join(ROOT, "third_party", "a64-kit")
+sys.path.insert(0, os.path.join(KIT, "lift"))
+sys.path.insert(0, os.path.join(KIT, "tools"))
+sys.path.insert(0, os.path.join(ROOT, "nx2"))
+for name in ("A64_FASTFP", "A64_FASTFP_MIN", "A64_LOCAL_REGS", "A64_KEEP_FLAGS", "A64_MARK_FRAME", "A64_HOT_FUNCS"):
+    os.environ.pop(name, None)
+import a64_lift  # noqa: E402
+import fastfp  # noqa: E402
+
+TAG = "# (fastfp)"
+KIT_EMIT = a64_lift.Lifter.emit_function   # (the kit's: nothing installed fastfp in this process)
+
+
+def fail(msg):
+    raise SystemExit("fastfp override: " + msg)
+
+
+def source_of(path, owner, name):
+    """The source lines of function `name` (a method of class `owner`, or a module function when owner is None)"""
+    text = open(path, encoding="utf-8").read()
+    tree = ast.parse(text)
+    nodes = tree.body
+    if owner:
+        nodes = next(n for n in nodes if isinstance(n, ast.ClassDef) and n.name == owner).body
+    fn = next(n for n in nodes if isinstance(n, ast.FunctionDef) and n.name == name)
+    lines = text.split("\n")[fn.lineno - 1:fn.end_lineno]
+    return textwrap.dedent("\n".join(lines)).split("\n")
+
+
+def check_text():
+    kit = source_of(os.path.join(KIT, "lift", "a64_lift.py"), "Lifter", "emit_function")
+    copy = source_of(os.path.join(ROOT, "nx2", "fastfp.py"), None, "emit_function")
+    tagged = [l for l in copy if l.rstrip().endswith(TAG)]
+    if len(tagged) < 20:
+        fail("only %d lines of the copy are tagged %r: the run gathering is not where this check looks" % (len(tagged), TAG))
+    plain = [l for l in copy if not l.rstrip().endswith(TAG)]
+    if plain != kit:
+        for n, (a, b) in enumerate(zip(plain, kit)):
+            if a != b:
+                fail("nx2/fastfp.py's emit_function is not a64-kit's apart from its %s lines, from line %d of the kit's:\n"
+                     "  copy: %s\n  kit:  %s" % (TAG, n + 1, a, b))
+        fail("nx2/fastfp.py's emit_function and a64-kit's differ in length (%d and %d lines, the tagged ones left out)"
+             % (len(plain), len(kit)))
+    print("ok   the copy is the kit's emit_function (%d lines) with %d tagged lines" % (len(kit), len(tagged)))
+
+
+def check_tree():
+    # Verify the actual compiler/runtime sources; Ocarina Reborn has its own toolchain paths.
+    import hashlib
+    from pathlib import Path
+    h = hashlib.sha256()
+    for rel in (Path(ROOT) / "tests/fastfp-kit-files.txt").read_text().splitlines():
+        data = (Path(KIT) / rel).read_bytes().replace(b"\r\n", b"\n")
+        h.update(rel.encode() + b"\0" + data + b"\0")
+    if h.hexdigest() != "6ba41d75f48d80a1ef4c424e92b505675f3da6f70d9e83b66efe9dcbba26f16f":
+        fail("a64-kit lift/runtime differs from the verified fast-FP source")
+    print("ok   fast-FP compiler/runtime source fingerprint")
+
+
+def check_install_order():
+    lift = open(os.path.join(ROOT, "nx2", "lift.py"), encoding="utf-8").read()
+    if not lift.index("fastfp.install()") < lift.index("lift_fixes.install()"):
+        fail("nx2/lift.py installs fastfp after lift_fixes: its emit_function would replace lift_fixes' wrapper")
+    print("ok   nx2/lift.py installs fastfp before lift_fixes")
+
+
+# ---- the copy run over a made-up function ----
+MUL = "a64_vfpx_mul32(c,c->vreg[%d],c->vreg[1],c->vreg[2],4);"
+
+
+def lifter(comments):
+    L = object.__new__(a64_lift.Lifter)
+    L.names, L.plt, L.no_local, L.after, L.jt, L.devirt = {}, {}, set(), {}, {}, {}
+    L.entries, L.comments, L.setjmp_owner = set(), comments, {}
+    L.stats, L.unhandled, L.ijump = collections.Counter(), collections.Counter(), collections.Counter()
+    return L
+
+
+def function(L, n_mul, label_at=None, after_at=None):
+    """A function at 0x1000: n_mul vector multiplies, an integer add, a return; the instruction texts by word"""
+    e = 0x1000
+    body, texts, labels = {}, {}, set()
+    words = [0x0e000000 + i for i in range(n_mul)] + [0x0b000000]
+    for i, w in enumerate(words):
+        pc = e + 4 * i
+        body[pc] = (("op",), w)
+        texts[(w, pc) if a64_lift.pc_relative(w) else w] = (MUL % (3 + i % 4) if i < n_mul else "c->x[5] = c->x[5] + 1;", 0)
+    body[e + 4 * len(words)] = (("ret",), 0xd65f03c0)
+    if label_at is not None:
+        labels.add(e + 4 * label_at)
+    if after_at is not None:
+        L.after[e + 4 * after_at] = "/* a patch */"
+    L.funcs = {e: (body, labels)}
+    return e, texts
+
+
+def emit(fn, comments, mode, **kw):
+    os.environ["A64_FASTFP"] = mode
+    L = lifter(comments)
+    e, texts = function(L, **kw)
+    text, _ = fn(L, e, texts)
+    return text, L.stats
+
+
+def check_run():
+    for comments in (False, True):
+        for kw in ({"n_mul": 12}, {"n_mul": 12, "label_at": 5}, {"n_mul": 3}):
+            want, _ = emit(KIT_EMIT, comments, "0", **kw)
+            got, stats = emit(fastfp.emit_function, comments, "0", **kw)
+            if got != want:
+                fail("A64_FASTFP=0, %s, comments %s: the copy wrote\n%s\nthe kit\n%s" % (kw, comments, got, want))
+            if stats.get("ff_regions"):
+                fail("A64_FASTFP=0 made regions")
+    text, stats = emit(fastfp.emit_function, True, "1", n_mul=12)
+    if stats.get("ff_regions") != 1 or stats.get("ff_ops") != 12 or text.count("A64_FF_ON(c)") != 1:
+        fail("12 multiplies in a row: %s regions of %s ops, not one of 12:\n%s" % (stats.get("ff_regions"), stats.get("ff_ops"), text))
+    if text.count("a64_ff_vmul32(") != 12 or text.count("a64_vfpx_mul32(") != 12 or "/* 00001004: 0e000001 */" not in text:
+        fail("the region does not hold the fast and the exact copy of every multiply, with their comments:\n" + text)
+    if text.index("A64_FF_ON(c)") > text.index("c->x[5] = c->x[5] + 1;"):
+        fail("the integer add after the run went before the region")
+    _, stats = emit(fastfp.emit_function, False, "1", n_mul=17, label_at=8)   # (the labelled one joins neither run)
+    if stats.get("ff_regions") != 2 or stats.get("ff_ops") != 16:
+        fail("a label on the 9th of 17 multiplies: %s regions of %s ops, not two of 8"
+             % (stats.get("ff_regions"), stats.get("ff_ops")))
+    want, _ = emit(KIT_EMIT, False, "1", n_mul=7)
+    got, stats = emit(fastfp.emit_function, False, "1", n_mul=7)
+    if got != want or stats.get("ff_regions"):
+        fail("7 multiplies (below A64_FASTFP_MIN) are not written as the kit writes them")
+    _, stats = emit(fastfp.emit_function, False, "1", n_mul=16, after_at=8)
+    if stats.get("ff_regions") != 1 or stats.get("ff_ops") != 8:
+        fail("a patch after the 9th of 16 multiplies: %s regions of %s ops, not one of 8 (the 7 after it too few)"
+             % (stats.get("ff_regions"), stats.get("ff_ops")))
+    os.environ.pop("A64_FASTFP", None)
+    print("ok   the copy writes what the kit writes with A64_FASTFP=0; with it on, runs become regions, cut at labels and patches")
+
+
+def main():
+    check_text()
+    check_tree()
+    check_install_order()
+    check_run()
+    print("fastfp override: ok")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_fastfp_regions.py b/tests/test_fastfp_regions.py
new file mode 100644
index 0000000..1b53109
--- /dev/null
+++ b/tests/test_fastfp_regions.py
@@ -0,0 +1,297 @@
+"""Fast float regions (A64_FASTFP, nx2/fastfp.py's ff_region): what may join a region, and the region's fast copy against
+plain IEEE single precision, game-free.
+
+Python, no compiler:
+  - ff_eligible: loads, vector moves, the FPX helpers and the exact compare blocks' FPCR tests and FPSR |= may join; a
+    store, a page mark, a raw guest pointer (a memcpy store), an MRS or MSR of FPSR/FPCR, a call, a branch may not;
+  - ff_region: a run below A64_FASTFP_MIN float ops is the exact text unchanged; above it the fast copy names the a64_ff_
+    ops, saves and puts back every register the run names, and keeps the exact copy.
+
+C (skipped without a compiler or on a host that is not x86-64): a region ff_region makes from lifted-style text (vector
+FMUL/FADD/FSUB in place, the 4- and 2-lane forms, scalar FADD/FSUB/FMUL/FDIV/FSQRT, an integer register written), with
+FASTFP_HEADER and stand-in exact helpers that count their calls and note the registers they first see. Built at
+-march=x86-64-v3 (the AVX forms) and -march=x86-64-v2 (SSE). Each build must:
+  - random normal operands (200,000 runs): the fast copy only, and every output register equal to the same ops done in
+    plain C in the host's default mode (a swapped operand order in a subtract or a divide fails);
+  - two quiet NaN operands: the exact copy (any NaN result does: a64_ff_guard_);
+  - 0 * inf (invalid), a denormal operand, a tiny product under FPCR.FZ (underflow, FTZ): the exact copy runs, and sees
+    the region's input registers as they were (the fast copy wrote over them);
+  - a tiny exact product without FZ, read again by the next op: the exact copy (a denormal operand flags it);
+  - overflow and divide-by-zero: fast, the infinities, FPSR.OFC / FPSR.DZC set;
+  - the gate closed (FPSR.IXC clear, or HOS_NO_FASTFP set): the exact copy;
+  - (hookshot) a scalar FMSUB in the region (FMA3 at x86-64-v3, the exact helper at v2), and at v3 the cases where x86's
+    FMA is not Arm's: 0 * inf + a quiet NaN, a product rounded up to 2^-126 (FZ off and on), a subnormal addend under
+    FZ: the exact copy. (Dropping fma32_fma32 from FF_CONV fails the 2^-126 cases.) Each op alone against its exact
+    body: tests/test_fastfp_fma.py.
+
+It has teeth (each by hand, then restored, 2026-11-11):
+  - the AVX ops' operands swapped (A64_FF_OP's "%2, %1, %0" made "%1, %2, %0"): the random runs differ at v3;
+  - the invalid flag no longer sending the region to its exact copy (a64_ff_end's 0x13 made 0x12): 0 * inf fails.
+
+    python -I -B tests/test_fastfp_regions.py [--cc clang]
+"""
+import argparse
+import os
+import platform
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+KIT = os.path.join(ROOT, "third_party", "a64-kit")
+sys.path.insert(0, os.path.join(KIT, "lift"))
+sys.path.insert(0, os.path.join(KIT, "tools"))
+sys.path.insert(0, os.path.join(ROOT, "nx2"))
+os.environ["A64_FASTFP"] = "1"
+os.environ.pop("A64_FASTFP_MIN", None)
+import fastfp as L  # noqa: E402  (the rules and the header live in nx2, outside the kit)
+import toolchain  # noqa: E402
+
+
+def fail(msg):
+    raise SystemExit("fastfp regions: " + msg)
+
+
+def check_python():
+    ok = ["c->x[8]=recomp_load64(c,c->x[3] + 0);",
+          "{ recomp_ldp64(c,(c->x[2]+0ULL),&c->vreg[1][0],&c->vreg[1][1]); }",
+          "a64_vfpx_mul32(c,c->vreg[3],c->vreg[1],c->vreg[2],4);",
+          "{ if (!a64_fcmp32(c,c->vreg[0],a64_vzero)) { if(c->fpcr & (1ULL<<24)) { c->fpsr|=128; } } }",
+          "{ uint8_t _s[16]; memcpy(_s,c->vreg[3],16); a64_vst16(c->vreg[4],_s); }"]
+    bad = ["recomp_store64(c,c->x[1] + 8,c->x[2]);",
+           "{ recomp_stp64(c,(c->x[12]+c->x[13]),c->vreg[20][0],c->vreg[20][1]); }",
+           "memcpy(A64_PTR(c->x[0]), c->vreg[1], 16);",
+           "c->x[3] = c->fpsr;",          # MRS FPSR
+           "c->fpcr = c->x[3];",          # MSR FPCR
+           "A64_ICALL(c, c->x[8]);",
+           "goto L_80001000;"]
+    for t in ok:
+        if not L.ff_eligible(t):
+            fail("should join a region: %s" % t)
+    for t in bad:
+        if L.ff_eligible(t):
+            fail("should end a region: %s" % t)
+    few = [(0x1000 + 4 * i, "a64_vfpx_add32(c,c->vreg[1],c->vreg[1],c->vreg[2],4);") for i in range(L.ff_min() - 1)]
+    text, n = L.ff_region(few)
+    if n or text != "\n".join(t for _, t in few):
+        fail("a run below the minimum must stay the exact text")
+    text, n = L.ff_region(few + [(0x2000, "c->x[5] = c->x[5] + 1; a64_vfpx_mul32(c,c->vreg[7],c->vreg[1],c->vreg[2],4);")])
+    if n != L.ff_min():
