diff --git a/tests/test_thread_arg_self.py b/tests/test_thread_arg_self.py
new file mode 100644
index 0000000..f01cf6d
--- /dev/null
+++ b/tests/test_thread_arg_self.py
@@ -0,0 +1,89 @@
+"""An nn::os call about the calling thread's own ThreadType finds its record without the scan of every thread.
+
+host/hos_thread.c's thread_arg (GetThreadPriority, GetThreadId, ChangeThreadPriority...) answered every call by
+hos_thread_of: a linear scan of all threads under threads_lock. The game asks about its own thread most of the time
+(GetThreadPriority(GetCurrentThread()), ~2,400 times a frame in Hyrule): the calling thread's record answers that,
+compared with its current ThreadType (the main thread's changes when it adopts the SDK's, hos_thread_adopt_guest).
+
+The fixture runs the real thread_arg over a stub scan that counts its calls.
+
+python -I -B tests/test_thread_arg_self.py [--cc gcc]
+"""
+import argparse
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cc", "gcc"]
+
+ROOT = Path(__file__).resolve().parents[1]
+MARKER = "static HosThread *thread_arg(Ctx *c, uint64_t tt) {"
+
+
+def check(cond, what):
+    if not cond:
+        raise SystemExit("FAIL: " + what)
+
+
+FIXTURE = r'''#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL:%d %s\n", __LINE__, #x); exit(1); } } while (0)
+typedef struct { uint64_t x[8]; } Ctx;
+typedef struct HosThread { uint64_t guest_tt; } HosThread;
+static HosThread a = {0x100}, b = {0x200};
+static HosThread *cur;
+static int scans, fatals;
+static HosThread *hos_thread_of(uint64_t tt) {
+    scans++;
+    return tt == a.guest_tt ? &a : tt == b.guest_tt ? &b : NULL;
+}
+static void hos_fatal(Ctx *c, const char *fmt, ...) { (void)c, (void)fmt; fatals++; }
+
+@THREAD_ARG@
+
+int main(void) {
+    cur = &a;
+    CHECK(thread_arg(NULL, 0x100) == &a && scans == 0);   /* (its own: no scan) */
+    CHECK(thread_arg(NULL, 0x200) == &b && scans == 1);   /* (another thread's: the scan) */
+    a.guest_tt = 0x300;                                   /* (adopted the SDK's ThreadType: the current one counts) */
+    CHECK(thread_arg(NULL, 0x300) == &a && scans == 1);
+    CHECK(thread_arg(NULL, 0x100) == NULL && scans == 2 && fatals == 1);   /* (the old one is unknown now) */
+    cur = NULL;                                           /* (a host thread: the scan) */
+    CHECK(thread_arg(NULL, 0x200) == &b && scans == 3);
+    return 0;
+}
+'''
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--cc", default="gcc")
+    a = p.parse_args()
+    src = (ROOT / "host" / "hos_thread.c").read_text(encoding="utf-8")
+    check(MARKER in src, "host/hos_thread.c has no '%s'" % MARKER)
+    start = src.index(MARKER)
+    part = src[start:start + re.search(r"^}", src[start:], re.M).end()]
+    check("HLE(_ZN2nn2os17GetThreadPriorityEPKNS0_10ThreadTypeE) { RET((uint32_t)hos_thread_priority(thread_arg(c, ARG(0))" in src,
+          "GetThreadPriority no longer finds its thread through thread_arg")
+
+    def run(tmp, name, body):
+        c, exe = Path(tmp) / (name + ".c"), Path(tmp) / (name + ".exe")
+        c.write_text(FIXTURE.replace("@THREAD_ARG@", body), encoding="utf-8")
+        subprocess.run([a.cc, "-std=c11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-but-set-variable", "-Wno-unknown-warning-option", "-Wno-unused-but-set-global", str(c), "-o", str(exe)], check=True)
+        return subprocess.run([str(exe)], capture_output=True, text=True)
+
+    fast = "if (cur && cur->guest_tt == tt) return cur;"
+    with tempfile.TemporaryDirectory(prefix="thread-arg-") as tmp:
+        r = run(tmp, "fixture", part)
+        check(r.returncode == 0, "thread_arg: not as expected\n" + r.stderr)
+        check(fast in part, "thread_arg no longer answers the calling thread's own ThreadType first")
+        for name, new, what in (("scan", "", "every call scanning passes"),
+                                ("any", "if (cur) return cur;", "the calling thread answering for any ThreadType passes")):
+            r = run(tmp, name, part.replace(fast, new))
+            check(r.returncode != 0 and "FAIL:" in r.stderr, what)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_threaded_rendering.py b/tests/test_threaded_rendering.py
new file mode 100644
index 0000000..abeb7ee
--- /dev/null
+++ b/tests/test_threaded_rendering.py
@@ -0,0 +1,124 @@
+"""The Insert menu's Threaded rendering (Auto / On / Off): its rule (gpu/vk/threaded_rendering.h) and how the row reaches
+the replay, the recorder and the host. A compiled check of the rule plus source checks; no game, no GPU.
+
+The rule is one function every reader shares: On is the render thread and the recorder thread together, Off neither,
+and Auto picks them where the process may run on 12 or more logical processors and the mode is safe. All of Auto is
+behind one constant, threaded::kAutoEnabled, which is on: turned off, Auto is Off on every PC and the row changes
+nobody's default. The source checks: that constant is the only gate and is on; the row is Auto by default,
+takes a restart and is in the readme and the development guide; RX_VK_ASYNC is read in one place (vk_replay.cpp
+render_thread_mode, the switch over the row), which async_on takes; the recorder asks the row only
+with RX_VK_RECORDER unset; and the host's present poll asks the renderer (HOS_OPT_RENDER_THREAD) instead of reading
+RX_VK_ASYNC itself, so the row's On answers the poll exactly as RX_VK_ASYNC=1 does.
+
+python -I -B tests/test_threaded_rendering.py [--cxx g++]
+"""
+import argparse
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+FIXTURE = r'''
+#include "threaded_rendering.h"
+#include <cstdio>
+#include <cstdlib>
+#include <initializer_list>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL:%d %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace mkwvk::threaded;
+int main() {
+    // (the row's values, in V-Sync's order)
+    CHECK(AUTO == 0 && ON == 1 && OFF == 2);
+    // (Auto's threshold: 12 logical processors the process may run on; an unknown count, 0, is too few)
+    CHECK(kAutoCpus == 12);
+    CHECK(!auto_picks(0) && !auto_picks(4) && !auto_picks(8) && !auto_picks(11));
+    CHECK(auto_picks(12) && auto_picks(16) && auto_picks(32) && auto_picks(256));
+    // (On and Off are the player's word: whatever the CPU, whatever is unsafe, whatever the gate)
+    for (const bool gate : {false, true})
+        for (const bool unsafe : {false, true})
+            for (const unsigned cpus : {0u, 4u, 11u, 12u, 64u}) {
+                CHECK(choose(ON, cpus, unsafe, gate).on && choose(ON, cpus, unsafe, gate).why == Why::On);
+                CHECK(!choose(OFF, cpus, unsafe, gate).on && choose(OFF, cpus, unsafe, gate).why == Why::Off);
+            }
+    // (Auto with the gate on: the CPU's rule, and off where the mode is not safe)
+    CHECK(choose(AUTO, 12, false, true).on && choose(AUTO, 12, false, true).why == Why::AutoCpus);
+    CHECK(choose(AUTO, 24, false, true).on);
+    CHECK(!choose(AUTO, 11, false, true).on && choose(AUTO, 11, false, true).why == Why::AutoFewCpus);
+    CHECK(!choose(AUTO, 8, false, true).on && !choose(AUTO, 0, false, true).on);
+    CHECK(!choose(AUTO, 12, true, true).on && choose(AUTO, 12, true, true).why == Why::AutoUnsafe);
+    CHECK(!choose(AUTO, 64, true, true).on && !choose(AUTO, 4, true, true).on);
+    // (Auto with the gate off: off on every PC, and said so)
+    for (const bool unsafe : {false, true})
+        for (const unsigned cpus : {0u, 4u, 11u, 12u, 64u})
+            CHECK(!choose(AUTO, cpus, unsafe, false).on && choose(AUTO, cpus, unsafe, false).why == Why::AutoGate);
+    // (a value that is none of the row's: Auto)
+    CHECK(choose(7, 64, false, true).why == Why::AutoCpus && choose(-1, 64, false, false).why == Why::AutoGate);
+    // (as built: the gate is on, so Auto is its rule: on from 12 logical processors where the mode is safe)
+    CHECK(kAutoEnabled);
+    for (const unsigned cpus : {0u, 8u, 11u}) CHECK(!choose(AUTO, cpus, false).on);
+    for (const unsigned cpus : {12u, 16u, 64u}) CHECK(choose(AUTO, cpus, false).on && !choose(AUTO, cpus, true).on);
+    CHECK(choose(ON, 4, false).on && !choose(OFF, 64, false).on);
+    std::printf("PASS: the Threaded rendering rule\n");
+}
+'''
+
+
+def block(text, marker):
+    """From marker to the brace closing its first one"""
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--cxx", default="g++")
+    a = p.parse_args()
+    vk = ROOT / "gpu" / "vk"
+    rule = (vk / "threaded_rendering.h").read_text(encoding="utf-8")
+    replay = (vk / "vk_replay.cpp").read_text(encoding="utf-8")
+    recorder = (vk / "vk_recorder.h").read_text(encoding="utf-8")
+    api = (vk / "vk_api.h").read_text(encoding="utf-8")
+    native = (ROOT / "host" / "nvn_native.c").read_text(encoding="utf-8")
+
+    # (the gate: one constant, on, and Auto's rule behind it)
+    if len(re.findall(r"constexpr bool \w+ = ", rule)) != 1 or "constexpr bool kAutoEnabled = true;" not in rule:
+        raise SystemExit("threaded_rendering.h: Auto's gate is not the one constant kAutoEnabled, on (turning it off changes "
+                         "the default for every PC with 12 threads: that is its own change)")
+    choose = block(rule, "constexpr Choice choose(")
+    if "bool auto_enabled = kAutoEnabled" not in choose or "if (!auto_enabled) return {false, Why::AutoGate};" not in choose:
+        raise SystemExit("threaded_rendering.h: choose() no longer keeps Auto behind the gate")
+
+    # (the run's choice: OCR_THREADED_RENDERING 1 or 0, unset Auto; resolved once, in vk_replay.cpp; no menu row)
+    resolved = block(replay, "bool threaded_rendering_on() {")
+    for need in ('getenv("OCR_THREADED_RENDERING")', "usable_cpus()", "threaded::choose(", "pools_mirrored()", "RX_VK_LOW_SPEC"):
+        if need not in resolved:
+            raise SystemExit("vk_replay.cpp: threaded_rendering_on() lost " + need)
+    mode = block(replay, "int render_thread_mode() {")
+    if 'const char* e = getenv("RX_VK_ASYNC");' not in mode or "return e ? atoi(e) : threaded_rendering_on() ? 1 : 0;" not in mode:
+        raise SystemExit("vk_replay.cpp: render_thread_mode() is not RX_VK_ASYNC over threaded_rendering_on()")
+    if "(rec::g_setting_thread = threaded_rendering_on, true)" not in replay:
+        raise SystemExit("vk_replay.cpp: the recorder does not follow threaded_rendering_on")
+    if "HOS_OPT_RENDER_THREAD" not in api or "HOS_OPT_RENDER_THREAD" not in native or "if (id == HOS_OPT_RENDER_THREAD) return async_on();" not in replay:
+        raise SystemExit("the host's present poll does not learn the render thread's choice (HOS_OPT_RENDER_THREAD)")
+    if "menu_threaded_rendering" in replay + recorder:
+        raise SystemExit("a menu row is named: threaded rendering has none")
+
+    with tempfile.TemporaryDirectory(prefix="threaded-rendering-") as tmp:
+        cpp = Path(tmp) / "fixture.cpp"
+        exe = Path(tmp) / "fixture"
+        cpp.write_text(FIXTURE, encoding="utf-8")
+        subprocess.run([a.cxx, "-std=c++20", "-Wall", "-Wextra", "-Werror", "-I" + str(vk), str(cpp), "-o", str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+    print("PASS: Threaded rendering: the rule, the gate (off), and the row's way to the replay, the recorder and the host")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_vk_occlusion_queries.py b/tests/test_vk_occlusion_queries.py
new file mode 100644
index 0000000..e9a969e
--- /dev/null
+++ b/tests/test_vk_occlusion_queries.py
@@ -0,0 +1,676 @@
+"""Real occlusion counts on Vulkan (RX_VK_OCC_QUERIES, gpu/vk/vk_replay.cpp): Ocarina of Time reads its samples-passed
+reports back on the CPU and leaves out of its draw lists the objects whose count was 0 (docs/development.md). The rule
+under test: a count that is not known for sure stays "visible" (4096); a wrong 0 hides an object that may be in view.
+
+The real code is cut out of the sources and compiled against a fake query pool, command buffer and guest memory:
+
+- vk_replay.cpp's ring (from kOccPool to occ_take): the numbering (one counter for every queue's state, a run split by
+  another queue's queries left visible, a queue's state copied mid-run), the reset and report cases' helpers, the ring's
+  room, the harvest (occ_collect), the report's submission value, the slot's report sequence (two reports into one slot
+  within one timestamp tick), and a slot made visible ahead of a stopped queue;
+- vk_draw.cpp's OccGuard and the mesh fallback's task-batch block, inside a fake draw(): a draw that returns after its
+  pass began, or whose vertex input was not all bound, or that is split into task batches, begins no query, and its
+  report stays visible; every query is begun at most once;
+- occ_queries_on() in its own process per environment: RX_VK_OCC_FIXED wins over RX_VK_OCC_QUERIES=1, and the queries
+  stay on with RX_VK_ASYNC=1 (the render thread).
+
+The rest is checked in the source: where the helpers are called, every draw command in draw() preceded by its query's
+issue with no way out between, the guard made after StatsQuery, the stopped queues' reports made visible.
+
+    python -I -B tests/test_vk_occlusion_queries.py [--cxx clang++]
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+REPLAY = ROOT / "gpu" / "vk" / "vk_replay.cpp"
+DRAW = ROOT / "gpu" / "vk" / "vk_draw.cpp"
+
+
+def block(text, marker):
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def ring_code(text):
+    """vk_replay.cpp's ring: from its constants to occ_take, without occ_queries_on (the pool is the fixture's)"""
+    start = text.index("constexpr uint64_t kOccPool")
+    end = text.index("/// The next recording slot, begun")
+    code = text[start:end]
+    return code.replace(block(code, "bool occ_queries_on()"), "")
+
+
+def guard_code(text):
+    """vk_draw.cpp's OccGuard, with its counters and occ_draw_counts"""
+    start = text.index("enum OccNotBegun")
+    guard = text[start:text.index("};", text.index("struct OccGuard {", start)) + 2]
+    return guard + "\n" + block(text, "void occ_draw_counts(uint64_t out[3]) {") + "\n"
+
+
+def batch_code(text):
+    """draw()'s mesh fallback task batches: one draw of the game's as several"""
+    return block(block(text, "void draw(VkCommandBuffer cmd, NvnState& s, const DrawArgs& d) {"),
+                 "if (p.fallback_task && !d.indirect) {")
+
+
+COMMON = r'''
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <set>
+#include <unordered_map>
+#include <vector>
+#define CHECK(ok) do { if (!(ok)) { std::fprintf(stderr, "failed line %d\n", __LINE__); std::exit(1); } } while (0)
+typedef struct VkQueryPool_T* VkQueryPool;
+typedef struct VkCommandBuffer_T* VkCommandBuffer;
+typedef int VkResult;
+typedef struct VkDevice_T* VkDevice;
+#define VK_NULL_HANDLE nullptr
+#define VK_SUCCESS 0
+#define VK_NOT_READY 1
+#define VK_QUERY_RESULT_64_BIT 1
+#define VK_QUERY_RESULT_WITH_AVAILABILITY_BIT 4
+#define VK_QUERY_CONTROL_PRECISE_BIT 1
+void logf(const char*, ...) {}
+'''
+
+FIXTURE = COMMON + r'''
+struct { VkDevice device = nullptr; bool occlusion_precise = true; } dev;
+struct NvnState {
+    bool render_enabled = true, raster_discard = false;
+    uint64_t occ_next = 0, occ_first = 0, occ_limit = 0;
+    bool occ_on = false, occ_overflow = false, occ_color = false;
+    struct { uint32_t mask = 0; } chmask;   // (no colour written: the game's depth-only boxes)
+};
+struct DrawArgs {
+    bool indirect = false;
+    int groups[3] = {0, 1, 1};
+    uint32_t first_task = 0;
+    VkQueryPool occ_pool = VK_NULL_HANDLE;
+    uint32_t occ_query = 0;
+};
+// the GPU: each query's count and whether it is done; the guest's memory: 8-byte words
+struct Q { uint64_t count = 0; bool avail = false; };
+std::vector<Q> gpu(1 << 16);
+std::map<uint64_t, uint64_t> guest;
+uint64_t done_value = 0, rec_part_next = 0;
+uint64_t completed() { return done_value; }
+struct {
+    void gpu_read(uint64_t a, void* d, size_t n) { uint64_t v = guest[a]; std::memcpy(d, &v, n); }
+    uint64_t gpu_guest(uint64_t a) { return a; }
+} host_obj, *host = &host_obj;
+int guest_cpu_write(uint64_t a, const void* s, uint64_t n) { uint64_t v = 0; std::memcpy(&v, s, n); guest[a] = v; return 0; }
+void memory_cpu_owned(uint64_t, uint64_t) {}
+bool env_on(const char*) { return false; }
+bool occ_queries_on() { return true; }
+void occ_draw_counts(uint64_t out[3]);
+int resets = 0, reads = 0;
+// (the rule: a query is reset from the host only once the submission it went out in has completed on the GPU, its
+// timeline value reached. Its availability bit is not enough: the command buffer may still be executing (the validation
+// layer's VUID-vkResetQueryPool-firstQuery-02741, then -vkCmdBeginQuery-None-00807 at its next use))
+std::vector<uint64_t> sent_in(1 << 16);   // (each query's submission value, 0: not taken since its reset)
+void vkResetQueryPool(VkDevice, VkQueryPool, uint32_t first, uint32_t n) {
+    resets++;
+    for (uint32_t i = 0; i < n; i++) {
+        if (sent_in[first + i] > done_value) {
+            std::fprintf(stderr, "query %u reset while its submission %llu is not done (done %llu)\n", first + i,
+                         (unsigned long long)sent_in[first + i], (unsigned long long)done_value);
+            std::exit(1);
+        }
+        gpu[first + i] = {}, sent_in[first + i] = 0;
+    }
+}
+VkResult vkGetQueryPoolResults(VkDevice, VkQueryPool, uint32_t first, uint32_t n, size_t, void* data, uint64_t stride, int) {
+    reads++;
+    VkResult r = VK_SUCCESS;
+    for (uint32_t i = 0; i < n; i++) {
+        uint64_t* w = (uint64_t*)((char*)data + i * stride);
+        w[1] = gpu[first + i].avail;
+        if (gpu[first + i].avail) w[0] = gpu[first + i].count;
+        else r = VK_NOT_READY;
+    }
+    return r;
+}
+// the command buffer: which queries are begun (each at most once until it is reset), and the samples drawn inside them
+std::set<uint32_t> open_q, begun_q;
+int begins = 0, ends = 0;
+bool begun_twice = false;
+std::map<uint32_t, uint64_t> drawn;
