+        self.t[0] = 142.0
+        c.part("button prompts")
+        self.t[0] = 143.0
+        c.enter(None)
+        s = c.seconds
+        self.assertEqual((s["finish"], s["finish: copying the new files in"], s["finish: button prompts"]), (33.0, 2.0, 30.0))
+        self.assertTrue(any("button prompts" in row and "30 s" in row for row in c.table()))
+
