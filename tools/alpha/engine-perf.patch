+    need(block(vma, "bool create_sparse_buffer("), ["VK_BUFFER_CREATE_SPARSE_BINDING_BIT | VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT",
+                                                    "vkGetBufferMemoryRequirements"], "vk_vma.cpp create_sparse_buffer()")
