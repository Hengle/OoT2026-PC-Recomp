diff --git a/tests/test_wb_shadow_follows_sync.py b/tests/test_wb_shadow_follows_sync.py
new file mode 100644
index 0000000..46d93bd
--- /dev/null
+++ b/tests/test_wb_shadow_follows_sync.py
@@ -0,0 +1,175 @@
+"""The write-back's shadow follows the mirror's sync (gpu/vk/vk_memory.cpp, "The shadow follows the mirror's sync"): a mirror
+sync of a pool with a shadow copies the same bytes into the shadow and notes each page (shadow_sync_copy); after the next
+write-back's forget those pages are known again (shadow_synced_known), but only while the pool's shadow is the one that
+had the copy; the notes of a shadow being freed are dropped first (shadow_synced_freed), as a shadow made after may get
+its handle. The functions are taken from the source as they are and run over pools of the test's own, with
+vkCmdCopyBuffer recorded. With RX_VK_SHADOW_FOLLOWS_SYNC=0 nothing is copied or noted (the fixture is run again so).
+
+python -I -B tests/test_wb_shadow_follows_sync.py [--cxx g++]
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, marker):
+    """the text from marker to the brace that closes its first '{'"""
+    start = text.index(marker)
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def through(text, first, last_block):
+    """the text from first to the end of the block that starts at last_block"""
+    start = text.index(first)
+    end = text.index(last_block, start)
+    return text[start:end] + block(text[end:], last_block)
+
+
+FIXTURE = r'''
+#include "gpu/vk/compat/ocarina_reborn_env.h"
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <vector>
+#define CHECK(ok) do { if (!(ok)) { std::fprintf(stderr, "failed line %d: %s\n", __LINE__, #ok); std::exit(1); } } while (0)
+constexpr uint64_t kPageShift = 12;
+using VkBuffer = uintptr_t;
+using VkCommandBuffer = uintptr_t;
+struct VmaAllocationT {};
+using VmaAllocation = VmaAllocationT*;
+constexpr uintptr_t VK_NULL_HANDLE = 0;
+struct VkBufferCopy { uint64_t srcOffset, dstOffset, size; };
+struct Copy { VkBuffer src, dst; std::vector<VkBufferCopy> rs; };
+std::vector<Copy> cmd_copies;
+void vkCmdCopyBuffer(VkCommandBuffer, VkBuffer src, VkBuffer dst, uint32_t n, const VkBufferCopy* r) {
+    cmd_copies.push_back({src, dst, std::vector<VkBufferCopy>(r, r + n)});
+}
+// (vk_memory.cpp's Pool, the fields these functions read)
+struct Pool {
+    uint64_t lo = 0, hi = 0;
+    VkBuffer shadow = VK_NULL_HANDLE;
+    std::vector<uint64_t> shadow_known;
+};
+std::map<uint64_t, Pool> imported;
+struct DeadShadow {
+    VkBuffer buffer;
+    VmaAllocation alloc;
+    uint64_t value;
+};
+std::deque<DeadShadow> dead_shadows;
+@FOLLOWS@
+@FREED@
+constexpr uint64_t kA = 0x10000000, kB = 0x20000000;   // (two pools of 128 pages)
+constexpr VkBuffer kShadowA = 0x51, kShadowB = 0x52, kNewShadow = 0x53, kStage = 0x99;
+Pool& pool(uint64_t lo, VkBuffer shadow) {
+    Pool p;
+    p.lo = lo, p.hi = lo + 128 * 4096, p.shadow = shadow, p.shadow_known.assign(2, 0);
+    return imported[lo] = p;
+}
+void reset() {
+    imported.clear(), dead_shadows.clear(), cmd_copies.clear(), shadow_synced.clear();
+    pool(kA, kShadowA), pool(kB, kShadowB);
+}
+bool known(uint64_t lo, uint64_t page) { return imported[lo].shadow_known[page >> 6] >> (page & 63) & 1; }
+int count_known(uint64_t lo) {
+    int n = 0;
+    for (uint64_t pg = 0; pg < 128; pg++) n += known(lo, pg);
+    return n;
+}
+int main(int argc, char** argv) {
+    const std::vector<VkBufferCopy> rs = {{0, 0x1000, 0x2000}, {0x3000, 0x5ffc, 8}, {0x4000, 0x7000, 0}};   // (pages 1-2, 5-6, none)
+    if (argc > 1 && !std::strcmp(argv[1], "off")) {   // (RX_VK_SHADOW_FOLLOWS_SYNC=0: as before, nothing copied or noted)
+        reset();
+        shadow_sync_copy(1, kStage, imported[kA], rs);
+        CHECK(cmd_copies.empty() && shadow_synced.empty());
+        shadow_synced_known();
+        CHECK(count_known(kA) == 0);
+        std::puts("PASS: with RX_VK_SHADOW_FOLLOWS_SYNC=0 a mirror sync leaves the shadow alone");
+        return 0;
+    }
+    // the sync's regions copied into the shadow too, and each page they touch noted with the pool and that shadow
+    reset();
+    shadow_sync_copy(1, kStage, imported[kA], rs);
+    CHECK(cmd_copies.size() == 1 && cmd_copies[0].src == kStage && cmd_copies[0].dst == kShadowA && cmd_copies[0].rs.size() == 3);
+    CHECK(cmd_copies[0].rs[1].dstOffset == 0x5ffc && cmd_copies[0].rs[1].size == 8);
+    CHECK(shadow_synced.size() == 4);
+    const uint64_t want[4] = {1, 2, 5, 6};
+    for (int i = 0; i < 4; i++)
+        CHECK(shadow_synced[i].lo == kA && shadow_synced[i].page == want[i] && shadow_synced[i].shadow == kShadowA);
+    // (after the write-back's forget) those pages known, and the notes gone
+    shadow_synced_known();
+    CHECK(shadow_synced.empty() && count_known(kA) == 4 && known(kA, 1) && known(kA, 2) && known(kA, 5) && known(kA, 6));
+    CHECK(count_known(kB) == 0);
+    // a pool with no shadow, or nothing to copy: nothing
+    reset();
+    imported[kA].shadow = VK_NULL_HANDLE;
+    shadow_sync_copy(1, kStage, imported[kA], rs);
+    shadow_sync_copy(1, kStage, imported[kB], {});
+    CHECK(cmd_copies.empty() && shadow_synced.empty());
+    // the pool's shadow made again since the sync: the new one never had the copy, so its pages stay unknown
+    reset();
+    shadow_sync_copy(1, kStage, imported[kA], rs);
+    shadow_sync_copy(1, kStage, imported[kB], {{0, 0, 4096}});
+    imported[kA].shadow = kNewShadow;
+    shadow_synced_known();
+    CHECK(shadow_synced.empty() && count_known(kA) == 0 && count_known(kB) == 1 && known(kB, 0));
+    // ... or the pool gone: nothing marked, nothing breaks
+    reset();
+    shadow_sync_copy(1, kStage, imported[kA], rs);
+    imported.erase(kA);
+    shadow_synced_known();
+    CHECK(shadow_synced.empty());
+    // a shadow being freed: its notes dropped before it goes, so a shadow made with its handle is not marked known
+    reset();
+    shadow_sync_copy(1, kStage, imported[kA], rs);
+    shadow_sync_copy(1, kStage, imported[kB], {{0, 0x2000, 4096}});
+    shadow_synced_freed();
+    CHECK(shadow_synced.size() == 5);   // (no shadow freed: all kept)
+    dead_shadows.push_back({kShadowA, nullptr, 7});
+    shadow_synced_freed();
+    CHECK(shadow_synced.size() == 1 && shadow_synced[0].lo == kB && shadow_synced[0].shadow == kShadowB);
+    imported[kA].shadow = kShadowA;   // (the new shadow, given the freed one's handle)
+    shadow_synced_known();
+    CHECK(count_known(kA) == 0 && count_known(kB) == 1 && known(kB, 2));
+    std::puts("PASS: the shadow follows the mirror's sync, for the shadow that had the copy only");
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cxx', default='g++')
+    parser.add_argument('--source', type=Path, default=ROOT / 'gpu/vk/vk_memory.cpp')
+    args = parser.parse_args()
+    text = args.source.read_text(encoding='utf-8')
+    fixture = (FIXTURE
+               .replace('@FOLLOWS@', through(text, 'bool shadow_follows_sync_on() {', 'void shadow_synced_known() {'))
+               .replace('@FREED@', block(text, 'void shadow_synced_freed() {')))
+    env = {k: v for k, v in os.environ.items() if k != 'RX_VK_SHADOW_FOLLOWS_SYNC'}
+    with tempfile.TemporaryDirectory(prefix='shadow-follows-sync-') as tmp:
+        src = Path(tmp) / 'follows.cpp'
+        exe = Path(tmp) / 'follows.exe'
+        src.write_text(fixture, encoding='utf-8')
+        subprocess.run([args.cxx, '-std=c++20', '-O1', '-Wall', '-Wextra', '-Werror', '-I', str(ROOT), str(src), '-o', str(exe)],
+                       check=True)
+        subprocess.run([str(exe)], check=True, env=env, timeout=60)
+        subprocess.run([str(exe), 'off'], check=True, env=dict(env, RX_VK_SHADOW_FOLLOWS_SYNC='0'), timeout=60)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/test_web_floor_steps.py b/tests/test_web_floor_steps.py
new file mode 100644
index 0000000..bf29e1c
--- /dev/null
+++ b/tests/test_web_floor_steps.py
@@ -0,0 +1,151 @@
+"""The floor web keeps its 60-Hz simulation above a 60 frame-rate cap (#2667, #2271).
+
+Compile the production patch applied to an authored update with its 0..3 clamp.
+Without this site the same executable checks fail: quarter-frame updates never
+run a step. Each floor needs its own carry, and the clamp and non-carry path stay
+unchanged. A long pause cannot leave whole steps queued behind the clamp.
+No game files or lifted function body are used.
+
+python -I -B tests/test_web_floor_steps.py [--cc gcc]
+"""
+import argparse
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cc", "gcc"]
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "nx2"))
+import oot_patches  # noqa: E402
+
+CUT = "    c->x[22]=recomp_fp_to_int(c->vreg[0][0]&UINT64_C(0xffffffff),32,32,1,3,c->fpcr,&c->fpsr);\n"
+LIFTED = ('#include "a64.h"\n'
+          'void f_80652cb0(Ctx *__restrict A64_NOESC c) {\n' + CUT +
+          '    const int32_t steps = (int32_t)c->x[22];\n'
+          '    c->x[0] = (uint32_t)(steps < 0 ? 0 : steps > 3 ? 3 : steps);\n'
+          '}\n'
+          'void f_90000000(Ctx *__restrict A64_NOESC c) {\n' + CUT + '}\n')
+CONTEXT = """#pragma once
+#define A64_NOESC
+typedef struct {
+    uint64_t x[32], vreg[32][2];
+    uint32_t fpcr, fpsr;
+} Ctx;
+"""
+FIXTURE = r'''#define _CRT_SECURE_NO_WARNINGS
+#include "frame_whole.h"
+#include <stdio.h>
+#include "a64.h"
+
+static FrameWhole fractions;
+static int carry = 1;
+static int failures;
+#define CHECK(test, what) do { if (!(test)) { printf("FAIL: %s\n", what); failures++; } } while (0)
+
+uint32_t hos_frame_whole(uint64_t at, uint32_t amount_bits) {
+    return frame_whole(&fractions, at, amount_bits, carry);
+}
+uint64_t recomp_fp_to_int(uint64_t bits, int in_width, int out_width, int sign,
+                         int mode, uint32_t fpcr, uint32_t *fpsr) {
+    float amount;
+    uint32_t low = (uint32_t)bits;
+    memcpy(&amount, &low, sizeof amount);
+    (void)in_width; (void)out_width; (void)sign; (void)mode; (void)fpcr; (void)fpsr;
+    return (uint64_t)(int64_t)(int32_t)amount;
+}
+@UPDATE@
+
+static uint32_t step(Ctx *ctx, uint64_t floor, float amount) {
+    uint32_t bits;
+    memcpy(&bits, &amount, sizeof bits);
+    ctx->x[19] = floor;
+    ctx->vreg[0][0] = bits;
+    f_80652cb0(ctx);
+    return (uint32_t)ctx->x[0];
+}
+static void reset(void) { memset(&fractions, 0, sizeof fractions); }
+
+int main(void) {
+    Ctx ctx = {0};
+    const uint64_t a = 0x10000, b = 0x20000;
+    uint32_t first = 0, second = 0;
+    for (int frame = 0; frame < 240; frame++) {
+        first += step(&ctx, a, 0.25f);
+        second += step(&ctx, b, 0.25f);
+    }
+    CHECK(first == 60, "240-Hz first floor must run 60 steps, not zero or 240");
+    CHECK(second == 60, "240-Hz second floor must keep its own fraction");
+
+    reset();
+    CHECK(step(&ctx, a, 0.25f) == 0, "quarter-frame sequence 1");
+    CHECK(step(&ctx, a, 0.25f) == 0, "quarter-frame sequence 2");
+    CHECK(step(&ctx, a, 0.25f) == 0, "quarter-frame sequence 3");
+    CHECK(step(&ctx, a, 0.25f) == 1, "quarter-frame sequence 4 carries one step");
+    reset(); first = 0;
+    for (int frame = 0; frame < 120; frame++) first += step(&ctx, a, 0.5f);
+    CHECK(first == 60, "120-Hz floor must run 60 steps");
+    reset(); first = 0;
+    for (int frame = 0; frame < 4; frame++) first += step(&ctx, a, 1.25f);
+    CHECK(first == 5, "updates over one frame keep their fraction too");
+
+    reset();
+    CHECK(step(&ctx, a, 0.75f) == 0 && step(&ctx, b, 0.25f) == 0,
+          "two floors must not share a remainder");
+    CHECK(step(&ctx, a, 0.25f) == 1 && step(&ctx, b, 0.25f) == 0,
+          "one floor advancing must not consume the other floor's fraction");
+    CHECK(step(&ctx, b, 0.5f) == 1, "the other floor keeps its pending fraction");
+
+    reset();
+    CHECK(step(&ctx, a, 4.75f) == 3, "the existing upper clamp stays three");
+    CHECK(step(&ctx, a, -1.0f) == 0, "the existing lower clamp stays zero");
+    CHECK(step(&ctx, a, 0.0f) == 0, "zero time delivers no steps");
+    reset();
+    CHECK(step(&ctx, a, 0.5f) == 0 && step(&ctx, a, 600.25f) == 3,
+          "a long pause is still clamped to three");
+    CHECK(step(&ctx, a, 0.25f) == 1, "only the fractional pause remainder survives");
+    for (int frame = 0; frame < 8; frame++)
+        CHECK(step(&ctx, a, 0.25f) == (frame % 4 == 3 ? 1u : 0u),
+              "a long pause leaves no whole-step backlog");
+    carry = 0; reset(); first = 0;
+    for (int frame = 0; frame < 60; frame++) first += step(&ctx, a, 1.0f);
+    CHECK(first == 60, "the ordinary 60-Hz path is unchanged");
+    CHECK(step(&ctx, a, 0.25f) == 0 && step(&ctx, a, 1.75f) == 1,
+          "without carry the original truncation remains");
+    if (!failures) puts("PASS: web floor steps");
+    return failures != 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default="gcc")
+    args = parser.parse_args()
+    patched, count = oot_patches.patch_whole_frames(LIFTED)
+    with tempfile.TemporaryDirectory(prefix="web-floor-steps-") as directory:
+        directory = Path(directory)
+        (directory / "a64.h").write_text(CONTEXT, encoding="utf-8")
+        source, binary = directory / "fixture.c", directory / "fixture.exe"
+        command = [args.cc, "-std=c11", "-Wall", "-Wextra", "-Werror", "-I", str(ROOT / "host"),
+                   str(source), "-o", str(binary)]
+        source.write_text(FIXTURE.replace("@UPDATE@", patched), encoding="utf-8")
+        subprocess.run(command, check=True)
+        subprocess.run([str(binary)], check=True, timeout=30)
+        # The negative control must compile, then fail the same behavioral checks.
+        source.write_text(FIXTURE.replace("@UPDATE@", LIFTED), encoding="utf-8")
+        subprocess.run(command, check=True)
+        native = subprocess.run([str(binary)], text=True, capture_output=True, timeout=30)
+        if native.returncode == 0 or "240-Hz first floor" not in native.stdout:
+            raise SystemExit("FAIL: the native truncation did not fail the 240-Hz check")
+        print("PASS: native truncation rejected by the same 240-Hz checks")
+    assert count == 1 and patched.count("hos_frame_whole(c->x[19] + 2296,") == 1
+    assert patched.count(CUT) == 1  # the authored unrelated function is left alone
+    assert oot_patches.patch_whole_frames(patched) == (patched, 0)
+    other = LIFTED.replace("c->x[22]=recomp_fp_to_int", "c->x[23]=recomp_fp_to_int")
+    assert oot_patches.patch_whole_frames(other) == (other, 0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_windows_stop.py b/tests/test_windows_stop.py
new file mode 100644
index 0000000..a250b59
--- /dev/null
+++ b/tests/test_windows_stop.py
@@ -0,0 +1,92 @@
+"""Drive Windows stop callbacks and their watchdog without Windows, a game or a GPU.
+
+The production unit is compiled against Win32 stand-ins, not a reimplemented policy.
+--compile-only is for Windows-target cross compilation; it never runs that executable.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+RUN_ALL_ARGS = ["--cc", "gcc"]
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def function(source, signature):
+    start = source.index(signature)
+    end = source.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default="gcc")
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--stop-source", type=Path)
+    parser.add_argument("--control-source", type=Path)
+    parser.add_argument("--compile-only", action="store_true")
+    args = parser.parse_args()
+    source = (args.stop_source or args.source / "host/windows_stop.c").read_text(encoding="utf-8")
+    source = source.replace("#ifdef _WIN32\n#include <windows.h>", "").removesuffix("#endif\n")
+    fixture = (ROOT / "tests/windows_stop_test.c").read_text(encoding="utf-8")
+    fixture = fixture.replace("/* ACTUAL_WINDOWS_STOP */", source)
+    control = (args.control_source or args.source / "host/control.c").read_text(encoding="utf-8")
+    relaunch = (args.source / "host/hos_relaunch.c").read_text(encoding="utf-8")
+    chain = r'''
+#define _CRT_SECURE_NO_WARNINGS
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+static int relaunch_asked, order, exited, restarted, window_logs, clean_ends;
+static void rx_close_asked(void) { assert(order == 0); order = 1; }
+static void hos_log(const char *fmt, ...) {
+    if (strstr(fmt, "close work done")) { assert(order == 1); order = 2; }
+    if (strstr(fmt, "display: window closed")) window_logs++;
+}
+static void hos_log_flush(void) { assert(order == 2); order = 3; }
+void ocr_diag_stop(void) { assert(order == 3); order = 4; clean_ends++; }
+static void relaunch(void) { assert(order == 4); restarted++; }
+static void ExitProcess(unsigned code) { assert(order == 4 && code == 0); exited++; }
+/* ACTUAL_FINISH */
+/* ACTUAL_CLOSE */
+/* ACTUAL_QUIT */
+int main(void) {
+    order = 1;
+    hos_close_finish();
+    assert(order == 4 && clean_ends == 1 && exited == 0 && restarted == 0);   /* returning after flush and clean-end */
+    order = 0; relaunch_asked = 1;
+    game_quit();
+    assert(exited == 1 && restarted == 0 && window_logs == 0 && clean_ends == 2);
+    puts("PASS: control quit flushes the shared tail, ignores pending restart and does not claim a window closed");
+    order = 1; exited = 0;
+    hos_window_closed_exit();
+    assert(exited == 1 && restarted == 1 && window_logs == 1 && clean_ends == 3);
+    order = 1; exited = restarted = window_logs = 0; relaunch_asked = 0;
+    hos_window_closed_exit();
+    assert(exited == 1 && restarted == 0 && window_logs == 1 && clean_ends == 4);
+    puts("PASS: window close still flushes before its optional relaunch and ExitProcess");
+}
+'''
+    chain = chain.replace("/* ACTUAL_FINISH */", function(relaunch, "void hos_close_finish(void)"))
+    chain = chain.replace("/* ACTUAL_CLOSE */", function(relaunch, "void hos_window_closed_exit(void)"))
+    chain = chain.replace("/* ACTUAL_QUIT */", function(control, "static void game_quit(void)"))
+    with tempfile.TemporaryDirectory(prefix="windows-stop-") as temp:
+        for name, text in (("events", fixture), ("close-chain", chain)):
+            path = Path(temp) / (name + ".c")
+            exe = Path(temp) / (name + ".exe")
+            path.write_text(text, encoding="utf-8")
+            subprocess.run([args.cc, "-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", str(path), "-o", str(exe)],
+                           check=True)
+            if args.compile_only:
+                print("PASS: compiled and linked " + name + " (not executed)")
+            else:
+                subprocess.run([str(exe)], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_work_lock.py b/tests/test_work_lock.py
new file mode 100644
index 0000000..601f47f
--- /dev/null
+++ b/tests/test_work_lock.py
@@ -0,0 +1,62 @@
+"""One build at a time in a work folder (make_game.py lock_work): a second build into a work folder another build is using stops at
+once, saying so, instead of compiling again what the first had not cached yet; the lock goes with the process that held it, so a
+build that ended (or was killed) keeps no one out; and main takes it before it reads or clears anything in the work folder.
+
+    python -I -B tests/test_work_lock.py
+"""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "nx2"))
+import make_game  # noqa: E402
+
+HOLD = ("import sys; sys.path.insert(0, %r); import make_game; make_game.lock_work(sys.argv[1]); print('held', flush=True); "
+        "sys.stdin.read()" % str(ROOT / "nx2"))
+
+with tempfile.TemporaryDirectory() as top:
+    work = os.path.join(top, "work")
+    os.makedirs(work)
+    holder = subprocess.Popen([sys.executable, "-I", "-c", HOLD, work], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        assert holder.stdout.readline().strip() == "held"
+        try:
+            make_game.lock_work(work)
+        except SystemExit as e:
+            assert e.code == 1, e.code
+        else:
+            raise AssertionError("a second build took the work folder another build holds")
+        assert not make_game._WORK_LOCK
+    finally:
+        holder.stdin.close()
+        holder.wait(timeout=30)
+    killed = subprocess.Popen([sys.executable, "-I", "-c", HOLD, work], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    assert killed.stdout.readline().strip() == "held"
+    killed.kill()
+    killed.wait(timeout=30)
+    make_game.lock_work(work)   # (the build before ended, or was killed: its lock went with it)
+    held = make_game._WORK_LOCK[1]
+    make_game.lock_work(work)   # (a second main() in the same process: the lock it holds, kept)
+    assert make_game._WORK_LOCK[1] is held and not held.closed
+    other = os.path.join(top, "other")
+    os.makedirs(other)
+    make_game.lock_work(other)   # (another work folder: the lock on the first one let go)
+    assert held.closed and make_game._WORK_LOCK[0] == os.path.join(other, make_game.WORK_LOCK)
+    holder = subprocess.Popen([sys.executable, "-I", "-c", HOLD, work], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        assert holder.stdout.readline().strip() == "held"   # (another build takes the first folder while this one holds "other")
+        make_game._WORK_LOCK[1].close()
+    finally:
+        holder.stdin.close()
+        holder.wait(timeout=30)
+
+src = (ROOT / "nx2" / "make_game.py").read_text(encoding="utf-8")
+body = src[src.index("\ndef main(a=None):"):]
+lock = body.index("lock_work(work)")
+for later in ("check_windows_sdk(work)", "stop_stray_compilers(work", "drop_stale_objects(work)", "translate()"):
+    assert lock < body.index(later), later
+assert lock > body.index("return check(a, a.work)")   # (make_game --check reads the game into work/probe beside a build: no lock)
+print("work lock: ok")
