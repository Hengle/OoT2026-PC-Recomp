+                     'thread_local int replay_pin_depth = 0;', 'thread_local DWORD_PTR replay_pin_prev = 0;',
+                     block(replay, 'struct ReplayPin {') + ';'])
+    texture = (ROOT / 'gpu/vk/vk_texture.cpp').read_text(encoding='utf-8')
