+/// A slot's report sequence moved on: a count still waiting for an older report there is not written
+uint64_t occ_slot_next(uint64_t addr) {
+    OccSlot& e = occ_slot(addr);
+    e.addr = addr;
+    return e.seq = ++occ_seq;
