+int main(void) {
+    static uint8_t mem0[1 << 16], mem1[1 << 16]; static uint64_t log0[4096];
+    int bad = 0, resumes_a = 0;
+    for (int s = 1; s <= 300; s++) {
+        Ctx st; memset(&st, 0, sizeof st); srand(s);
+        for (int i = 0; i < 32; i++) st.x[i] = ((uint64_t)rand() << 20) ^ rand();
+        for (int i = 0; i < 32; i++) { st.vreg[i][0] = rand(); st.vreg[i][1] = (uint64_t)rand() << 33; }
+        st.x[1] = 0x1000 + 8 * (rand() % 512); st.x[2] = 0x6000 + 8 * (rand() % 512);   /* (the made-up loads' and stores' bases) */
+        st.x[28] = 40 + rand() % 40; st.n = rand() & 1; st.z = rand() & 1; st.c = rand() & 1; st.v = rand() & 1; st.poll = s & 1;
+        for (size_t i = 0; i < sizeof mem0; i++) mem0[i] = (uint8_t)rand();
+        Ctx a = st, b = st; int na, pa, pb, ra;
+        memcpy(guest_mem, mem0, sizeof mem0); memset(a64_dirty, 0, 64); nlog = 0; polls = 0; resumes = 0; sjd = 0;
+        FN_A(&a); na = nlog; pa = polls; ra = resumes; memcpy(log0, log_, sizeof log_); memcpy(mem1, guest_mem, sizeof mem1);
+        uint8_t d0[64]; memcpy(d0, a64_dirty, 64);
+        memcpy(guest_mem, mem0, sizeof mem0); memset(a64_dirty, 0, 64); nlog = 0; polls = 0; resumes = 0; sjd = 0;
+        FN_B(&b); pb = polls;
+        if (memcmp(&a, &b, sizeof a) || na != nlog || memcmp(log0, log_, na * 8) || memcmp(mem1, guest_mem, sizeof mem1)
+            || memcmp(d0, a64_dirty, 64) || pa != pb || ra != resumes || sjd) { printf("state %d differs\n", s); bad++; }
+        resumes_a += ra;
+    }
+    printf("%d of 300 states differ, %d setjmp resumes\n", bad, resumes_a);
+    return bad != 0;
+}
+"""
+
+
+def find_cc(asked):
+    """Clang: the one asked, $CC, clang on PATH, or the build's HOOKSHOT_MINGW toolchain; None when there is none"""
+    cands = [asked] if asked else [os.environ.get("CC"), "clang"]
+    m = os.environ.get("HOOKSHOT_MINGW")
+    if m and not asked:
+        cands += [os.path.join(m, "bin", n) for n in ("x86_64-w64-mingw32-clang.exe", "clang.exe", "clang")]
+    for c in cands:
+        if not c:
+            continue
+        exe = shutil.which(c) or (c if os.path.isfile(c) else None)
+        if not exe:
+            continue
+        r = subprocess.run([exe, "--version"], capture_output=True, text=True)
+        if r.returncode == 0 and "clang" in r.stdout.lower():
+            return exe
+        if asked:
+            return None
+    return None
+
+
+class Programs:
+    """One temporary folder: the build's guest model, and each program compiled and run"""
+
+    def __init__(self, cc, d):
+        import rtgen
+        import kit
+        self.cc, self.d = cc, d
+        rt = rtgen.write(os.path.join(d, "rt64"))
+        for h in ("a64_suyu.h", "a64_fpx.h"):   # (the generated FP helpers: none of the shapes here call them)
+            open(os.path.join(d, h), "w").write("")
+        open(os.path.join(d, "pre.h"), "w").write("#include <stdint.h>\nextern uint8_t guest_mem[];\n")
+        self.fl = ["-O1", "-ffp-contract=off", "-fno-strict-aliasing", "-I" + rt, "-I" + d, "-I" + os.path.join(kit.KIT, "rt"),
+                   "-DA64_POLLING", "-DA64_WRITE_TRACK", "-DA64_HOST_BASE=((uintptr_t)guest_mem)", "-include",
+                   os.path.join(d, "pre.h"), "-Wno-everything", "-mllvm", "-rotation-max-header-size=0"]
+
+    def run(self, tag, sources, fn_a, fn_b, stubs, objects=(), want_resumes=False):
+        """sources: {file name: text}; FN_A whole and FN_B split; stubs: C for the functions they call"""
+        for n, t in sources.items():
+            open(os.path.join(self.d, n), "w", newline="\n").write(t)
+        open(os.path.join(self.d, "driver.c"), "w", newline="\n").write(DRIVER.replace("@@STUBS@@", stubs))
+        exe = os.path.join(self.d, tag + ".exe")
+        r = subprocess.run([self.cc] + self.fl + ["-DFN_A=" + fn_a, "-DFN_B=" + fn_b] +
+                           [os.path.join(self.d, n) for n in list(sources) + ["driver.c"]] + list(objects) + ["-o", exe],
+                           capture_output=True, text=True)
+        check(r.returncode == 0, "%s compiles: %s" % (tag, (r.stdout + r.stderr)[-2000:]))
+        if r.returncode:
+            return
+        r = subprocess.run([exe], capture_output=True, text=True, timeout=120)
+        last = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "exit %d" % r.returncode
+        print("%s: %s" % (tag, last))
+        check(r.returncode == 0, "%s: the split function runs as the whole one (%s)" % (tag, last))
+        if want_resumes:
+            check(" 0 setjmp resumes" not in last, "%s: some states resumed through setjmp" % tag)
+
+
+def compiled_checks(cc):
+    stubs_written = "void f_callee(Ctx *A64_NOESC c) { ev(c, 1); }\nvoid f_tail(Ctx *A64_NOESC c) { ev(c, 2); }\n"
+    head = '#include "a64.h"\nvoid f_callee(Ctx *A64_NOESC);\nvoid f_tail(Ctx *A64_NOESC);\n'
+    with tempfile.TemporaryDirectory() as d:
+        P = Programs(cc, d)
+        # 1. written shapes
+        for k in range(4):
+            fn = gen_function("f_00000001", random.Random(100 + k), blocks=50 + 20 * k)
+            out, st = SG.split_text(head + fn + "\n", piece_kb=1, min_kb=0)
+            check(st["functions_split"] == 1, "program %d split" % k)
+            P.run("written %d (%d pieces)" % (k, st["pieces"]),
+                  {"orig.c": head + fn + "\n", "split.c": out.replace("f_00000001", "f_00000002").replace("s_00000001_", "s_00000002_")},
+                  "f_00000001", "f_00000002", stubs_written)
+        # 2. emitted by the real lifter
+        main_name, other = "f_%08x" % MAIN, "f_%08x" % (MAIN + 0x0F000000)
+        for k, (seed, blocks) in enumerate(((11, 40), (12, 70), (13, 100))):
+            text, refs, _ = emit_real(seed, blocks)
+            decl = '#include "a64.h"\n__attribute__((returns_twice)) int recomp_sj_setjmp(void **slot);\n' + \
+                   "".join("void %s(Ctx *A64_NOESC);\n" % r for r in refs)
+            out, st = SG.split_text(decl + text, piece_kb=1, min_kb=0, only={main_name})
+            check(st["functions_split"] == 1, "emitted program %d split" % k)
+            stubs = "".join("void %s(Ctx *A64_NOESC c) { %s }\n" % (r, "owner(c);" if r == "f_%08x" % OWNER else "ev(c, %d);" % (20 + j))
+                            for j, r in enumerate(refs))
+            P.run("emitted %d (%d pieces)" % (k, st["pieces"]),
+                  {"orig.c": decl + text, "split.c": out.replace(main_name, other).replace("s_%08x_" % MAIN, "s_%08x_" % (MAIN + 0x0F000000))},
+                  main_name, other, stubs, want_resumes=True)
+        # 3. build.py's compile_one with the split flag
+        import build
+        big = big_source("f_00002000")
+        src = os.path.join(d, "code_000.c")
+        open(src, "w", newline="\n").write(big)
+        obj = os.path.join(d, "code_000.o")
+        old_cache = build.OBJ_CACHE
+        build.OBJ_CACHE = os.path.join(d, "objcache")
+        try:
+            _, secs, err = build.compile_one((P.cc, src, obj, P.fl + [SG.flag(SG.PIECE_KB)], b""))
+        finally:
+            build.OBJ_CACHE = old_cache
+        check(err is None and os.path.exists(obj), "compile_one compiles the chunk with the split flag: %s" % (err or "")[-1500:])
+        check(not os.path.exists(obj[:-2] + ".split.c"), "compile_one removes the split copy")
+        check(os.path.exists(obj) and b"s_00002000_" in open(obj, "rb").read(), "compile_one's object holds the pieces (it compiled the copy)")
+        if err is None:
+            P.run("compile_one", {"whole.c": big.replace("f_00002000", "f_00002001")}, "f_00002001", "f_00002000",
+                  stubs_written, objects=[obj])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--cc", help="Clang (default: $CC, clang on PATH, or HOOKSHOT_MINGW's)")
+    a = ap.parse_args()
+    text_checks()
+    real_text_checks()
+    cc = find_cc(a.cc)
+    if not cc:
+        check(False, "no Clang to compile with (%s): the build compiles lifted code with clang; give --cc, $CC, PATH or "
+                     "HOOKSHOT_MINGW" % (a.cc or "none found"))
+    elif sys.maxsize <= 2 ** 32:
+        check(False, "a 64-bit host is needed (the guest model's window)")
+    else:
+        compiled_checks(cc)
+    print("split_giants: %s" % ("FAILED (%d)" % len(FAILS) if FAILS else "OK"))
+    sys.exit(1 if FAILS else 0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_split_ub_flush.py b/tests/test_split_ub_flush.py
new file mode 100644
index 0000000..4a6737f
--- /dev/null
+++ b/tests/test_split_ub_flush.py
@@ -0,0 +1,130 @@
+"""A submission cut into parts (gpu/vk/vk_replay.cpp maybe_split, RX_VK_CHUNK) writes the stream's uniform updates into
+guest memory once, at its last part, as an unsplit submission does (finish_recording), on Intel without VRAM mirrors
+(pools_mirrored, the iGPUs); elsewhere, or with RX_VK_SPLIT_UBFLUSH=1, each part's end writes those recorded so far, as
+before. Source checks plus the decision compiled
+alone against a table; no game or GPU required.
+
+Written at each part's end, the draws of the later parts that read those ranges straight from guest memory saw a state an
+unsplit submission never shows: on Intel, white blocks and flashes in Kokiri Forest and white save thumbnails, and a
+whole-screen white flash every 8 frames on an Arc 140V (https://github.com/NotRexed/Hookshot/issues/999). flush_ub_updates writes the entries from
+ub_first_of_recording on, so a part's end must neither write them nor move that index when it does not flush.
+
+python -I -B tests/test_split_ub_flush.py [--cxx g++]
+"""
+import argparse
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+VK = ROOT / "gpu" / "vk"
+
+
+def block(text, marker):
+    """From marker to the brace closing its first one"""
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+# RX_VK_SPLIT_UBFLUSH's value (None: unset), the GPU's vendor, whether its buffer pools have VRAM mirrors, and whether a
+# part's end writes the updates
+VENDORS = {"intel": 0x8086, "amd": 0x1002, "nvidia": 0x10DE}
+CASES = ([(None, "intel", 0, 0), (None, "intel", 1, 1)] +
+         [(None, g, m, 1) for g in ("amd", "nvidia") for m in (0, 1)] +
+         [(v, g, m, 1) for v in ("1", "on", "yes") for g in VENDORS for m in (0, 1)] +
+         [(v, g, m, 0) for v in ("0", "off", "false", "no", "") for g in VENDORS for m in (0, 1)])
+FIXTURE = r"""
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+struct { struct { unsigned vendorID; } props; } dev;
+static bool the_mirrored;       // (vk_memory.cpp mirror_on: the buffer pools have VRAM mirrors)
+static bool pools_mirrored() { return the_mirrored; }
+static const char* the_value;   // (the switch's value, nullptr: unset; read in place of the environment)
+static const char* fake_getenv(const char* name) { return strcmp(name, "RX_VK_SPLIT_UBFLUSH") ? nullptr : the_value; }
+static bool fake_env_on(const char* name) { const char* v = fake_getenv(name); return v && !env_value_off(v); }
+static bool part_flush_for(const char* value, unsigned vendor, bool mirrored) {
+    the_value = value;
+    dev.props.vendorID = vendor;
+    the_mirrored = mirrored;
+    return @@DECISION@@();
+}
+int main(int argc, char** argv) {
+    // (argv: value or -unset, the vendor, 1 with mirrors or 0, 1 written at each part's end or 0)
+    for (int i = 1; i + 3 < argc; i += 4) {
+        const char* v = strcmp(argv[i], "-unset") ? argv[i] : nullptr;
+        const unsigned vendor = (unsigned)strtoul(argv[i + 1], nullptr, 0);
+        const bool mirrored = atoi(argv[i + 2]) != 0;
+        const bool got = part_flush_for(v, vendor, mirrored);
+        if (got != (atoi(argv[i + 3]) != 0)) {
+            printf("FAIL: RX_VK_SPLIT_UBFLUSH=[%s], vendor 0x%04x, %s: %s\n", v ? v : "(unset)", vendor,
+                   mirrored ? "mirrors" : "no mirrors", got ? "written at each part's end" : "written at the last part");
+            return 1;
+        }
+    }
+    return 0;
+}
+"""
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--cxx", default="g++")
+    args = p.parse_args()
+    src = (VK / "vk_replay.cpp").read_text(encoding="utf-8")
+
+    split = block(src, "void split_part(VkCommandBuffer& cmd) {")   # (the part's end: maybe_split says when)
+    if "static const bool part_flush = [] {" not in split:
+        raise SystemExit("FAIL: split_part writes the uniform updates at every part's end (no part_flush decision)")
+    code = "\n".join(line.split("//")[0] for line in split.splitlines())
+    if code.count("flush_ub_updates(") != 1 or "if (part_flush) flush_ub_updates(cmd);" not in code:
+        raise SystemExit("FAIL: split_part writes the uniform updates at a part's end without asking part_flush")
+    if code.count("ub_first_of_recording =") != 1 or \
+            "if (part_flush) ub_first_of_recording = ub_updates.size();" not in code:
+        raise SystemExit("FAIL: split_part moves ub_first_of_recording when the part's end did not write the updates: "
+                         "the last part would leave the earlier parts' updates unwritten")
+    finish = block(src, "void finish_recording(uint64_t value) {")
+    if "flush_ub_updates(r.cmd);" not in finish:
+        raise SystemExit("FAIL: finish_recording no longer writes the submission's uniform updates")
+    flush = block(src, "void flush_ub_updates(VkCommandBuffer cmd) {")
+    if "for (size_t i = ub_first_of_recording; i < ub_updates.size(); i++)" not in flush:
+        raise SystemExit("FAIL: flush_ub_updates no longer writes from ub_first_of_recording on: check what a part's "
+                         "end has to keep")
+    print("source: a part's end writes the updates and moves the window only under part_flush; the last part writes "
+          "them all")
+
+    lam = split[split.index("static const bool part_flush = [] {") + len("static const bool part_flush = "):]
+    lam = lam[:lam.index("}();") + 1]
+    with tempfile.TemporaryDirectory(prefix="split-ubflush-") as tmp:
+        tmp = Path(tmp)
+        cpp, exe = tmp / "t.cpp", tmp / "t.exe"
+        lam = lam.replace("getenv(", "fake_getenv(").replace("env_on(", "fake_env_on(")
+        cpp.write_text(FIXTURE.replace("@@DECISION@@", "(" + lam + ")"), encoding="utf-8")
+        r = subprocess.run([args.cxx, "-std=c++20", "-include", str(VK / "compat" / "ocarina_reborn_env.h"), "-Wall",
+                            "-Wextra", "-Werror", str(cpp), "-o", str(exe)], capture_output=True, text=True, timeout=120)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            raise SystemExit("FAIL: the part_flush decision did not build alone")
+        argv = []
+        for value, gpu, mirrored, want in CASES:
+            argv += ["-unset" if value is None else value, hex(VENDORS[gpu]), str(mirrored), str(want)]
+        r = subprocess.run([str(exe), *argv], capture_output=True, text=True, timeout=30)
+        if r.returncode:
+            print(r.stdout + r.stderr)
+            raise SystemExit("FAIL: a split submission writes its uniform updates where it should not (Intel without "
+                             "mirrors: at the last part; elsewhere at each part's end; RX_VK_SPLIT_UBFLUSH by the "
+                             "switches' rule)")
+    print("decision: %d cases: unset, Intel without mirrors at the last part, Intel with mirrors and others at each part's "
+          "end; RX_VK_SPLIT_UBFLUSH by the switches' rule" % len(CASES))
+    print("PASS")
+
+
+if __name__ == "__main__":
+    main()
