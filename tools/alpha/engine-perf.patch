diff --git a/tests/test_shadow_bias_once.py b/tests/test_shadow_bias_once.py
new file mode 100644
index 0000000..a787ef7
--- /dev/null
+++ b/tests/test_shadow_bias_once.py
@@ -0,0 +1,33 @@
+"""RX_VK_SHADOW_BIAS is read once, safely across the threads that record draws.
+
+dynamic_state() kept the shadow bias in two function statics, initialised by hand: `units < 0` meant "not read yet",
+then units was set to the default before getenv/sscanf filled both. Parallel recording threads (RX_VK_PARALLEL) reach it
+at once, so one thread could read units and slope while another was still writing them: a data race, and a draw could
+take the 250000 default with a slope not read yet, or a half-written pair. Now both start at their defaults and the
+variable is parsed in a function-local static's initializer, which C++ runs exactly once and makes visible to every
+thread before they go on.
+
+python -I -B tests/test_shadow_bias_once.py
+"""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    src = (ROOT / "gpu" / "vk" / "vk_draw.cpp").read_text(encoding="utf-8")
+    at = src.find('getenv("RX_VK_SHADOW_BIAS")')
+    if at < 0:
+        raise SystemExit("RX_VK_SHADOW_BIAS is no longer read in vk_draw.cpp: this test needs updating")
+    block = src[src.rfind("{", 0, src.rfind("static float units", 0, at)):at]
+    if "static float units" not in block:
+        raise SystemExit("the shadow bias statics moved: this test needs updating")
+    if "if (units < 0)" in block:
+        raise SystemExit("RX_VK_SHADOW_BIAS is read under a plain `units < 0` check: threads race on units and slope")
+    if "static const bool" not in block or "= [] {" not in block:
+        raise SystemExit("RX_VK_SHADOW_BIAS is not read in a static initializer (once, thread-safely)")
+    print("RX_VK_SHADOW_BIAS read once, in a static initializer")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_sparse_mirror.cpp b/tests/test_sparse_mirror.cpp
new file mode 100644
index 0000000..f6e61a2
--- /dev/null
+++ b/tests/test_sparse_mirror.cpp
@@ -0,0 +1,91 @@
+// tests/test_sparse_mirror.py: gpu/vk/sparse_mirror.h, the blocks of a sparse VRAM mirror that hold memory
+#include "../gpu/vk/sparse_mirror.h"
+
+#include <cstdio>
+#include <vector>
+
+namespace {
+int failures = 0;
+void check(bool ok, const char* what) {
+    if (!ok) failures++, std::printf("FAIL: %s\n", what);
+}
+struct Pool { uint64_t lo, hi; };
+constexpr uint64_t K = 64 * 1024;
+std::vector<uint8_t> live_of(uint64_t lo, uint64_t hi, std::vector<Pool> pools) {
+    return sparse_mirror::live_blocks(lo, hi, K, pools.begin(), pools.end());
+}
+}  // namespace
+
+int main() {
+    // a mirror of 8 blocks; the game's pools in blocks 1 and 3-4 (the second crosses a block's end)
+    const uint64_t lo = 0x10000000;
+    auto live = live_of(lo, lo + 8 * K, {{lo + K + 100, lo + K + 200}, {lo + 3 * K + 4096, lo + 5 * K - 4096}});
+    check(live == std::vector<uint8_t>({0, 1, 0, 1, 1, 0, 0, 0}), "the blocks a pool is in, and only those");
+
+    // a pool that starts far below the mirror and reaches into it, with a later small one before the mirror
+    live = live_of(lo, lo + 4 * K, {{lo - 64 * K, lo + 2 * K - 1}, {lo - 4 * K, lo - 2 * K}});
+    check(live == std::vector<uint8_t>({1, 1, 0, 0}), "an earlier, longer pool still counts");
+
+    // a pool past the mirror's end, one ending at its start, an empty one
+    live = live_of(lo, lo + 2 * K, {{lo - K, lo}, {lo + K, lo + K}, {lo + 2 * K, lo + 3 * K}});
+    check(live == std::vector<uint8_t>({0, 0}), "pools touching the ends but not in it, and an empty one, reach nothing");
+
+    // a mirror whose size is not whole blocks: its last block is still a block
+    live = live_of(lo, lo + K + 4096, {{lo + K, lo + K + 4096}});
+    check(live.size() == 2 && live[1] == 1 && live[0] == 0, "a last partial block");
+    check(live_of(lo, lo, {{lo, lo + K}}).empty(), "an empty mirror has no blocks");
+
+    // block_span
+    size_t a = 0, e = 0;
+    sparse_mirror::block_span(K - 1, 2, K, 8, &a, &e);
+    check(a == 0 && e == 2, "a range across a block's end reaches both");
+    sparse_mirror::block_span(3 * K, K, K, 8, &a, &e);
+    check(a == 3 && e == 4, "a whole block reaches it alone");
+    sparse_mirror::block_span(7 * K, 4 * K, K, 8, &a, &e);
+    check(a == 7 && e == 8, "clamped to the mirror's blocks");
+    sparse_mirror::block_span(2 * K, 0, K, 8, &a, &e);
+    check(a == e, "an empty range reaches none");
+
+    // runs
+    const std::vector<uint8_t> has = {1, 1, 0, 1, 0, 0, 1, 1};
+    std::vector<std::pair<size_t, size_t>> got;
+    sparse_mirror::runs(has.size(), [&](size_t i) { return has[i]; }, true, [&](size_t f, size_t c) { got.push_back({f, c}); });
+    check(got == std::vector<std::pair<size_t, size_t>>({{0, 2}, {3, 1}, {6, 2}}), "runs of blocks with memory");
+    got.clear();
+    sparse_mirror::runs(has.size(), [&](size_t i) { return has[i]; }, false, [&](size_t f, size_t c) { got.push_back({f, c}); });
+    check(got == std::vector<std::pair<size_t, size_t>>({{2, 1}, {4, 2}}), "runs of blocks with none");
+
+    // clip: a copy from one mirror into another, cut where either side's block has no memory
+    const auto src_has = [&](uint64_t o) { return has[o / K] != 0; };
+    const auto all = [](uint64_t) { return true; };
+    auto out = sparse_mirror::clip({{0, 0, 8 * K}}, K, src_has, all);
+    check(out.size() == 3 && out[0].src == 0 && out[0].size == 2 * K && out[1].src == 3 * K && out[1].size == K &&
+              out[2].src == 6 * K && out[2].size == 2 * K,
+          "a whole copy keeps the blocks with memory, merged");
+    // offsets that differ between source and destination: cut at both sides' block ends
+    out = sparse_mirror::clip({{K / 2, 0, 2 * K}}, K, all, [&](uint64_t d) { return d < K; });
+    check(out.size() == 1 && out[0].src == K / 2 && out[0].dst == 0 && out[0].size == K,
+          "the destination's block with none cut off, though the source's block end is elsewhere");
+    out = sparse_mirror::clip({{0, 0, 3 * K}}, K, [&](uint64_t s) { return s / K != 1; }, all);
+    check(out.size() == 2 && out[0].size == K && out[1].src == 2 * K && out[1].size == K, "a hole in the middle");
+    out = sparse_mirror::clip({{4096, 4096, 100}}, K, all, all);
+    check(out.size() == 1 && out[0].src == 4096 && out[0].size == 100, "a small copy inside one block, kept whole");
+    out = sparse_mirror::clip({{0, 0, K}}, K, [](uint64_t) { return false; }, all);
+    check(out.empty(), "nothing from a source with no memory");
+
+    // cut_src: a pending refill's range cut out of the copies by their source offsets
+    out = sparse_mirror::cut_src({{0, 100, 3 * K}}, {{K, 2 * K}});
+    check(out.size() == 2 && out[0].src == 0 && out[0].dst == 100 && out[0].size == K && out[1].src == 2 * K &&
+              out[1].dst == 100 + 2 * K && out[1].size == K,
+          "a range in the middle cut out, the destinations kept in step");
+    out = sparse_mirror::cut_src({{0, 0, K}, {2 * K, 2 * K, K}}, {{K / 2, 5 * K / 2}});
+    check(out.size() == 2 && out[0].size == K / 2 && out[1].src == 5 * K / 2 && out[1].dst == 5 * K / 2 && out[1].size == K / 2,
+          "a range over two copies' ends");
+    out = sparse_mirror::cut_src({{0, 0, K}}, {{0, K}});
+    check(out.empty(), "a range over the whole copy");
+    out = sparse_mirror::cut_src({{0, 0, K}}, {{2 * K, 3 * K}, {K, K}});
+    check(out.size() == 1 && out[0].size == K, "ranges past it, and an empty one, leave it whole");
+    if (failures) return 1;
+    std::printf("sparse mirror blocks: ok\n");
+    return 0;
+}
diff --git a/tests/test_sparse_mirror.py b/tests/test_sparse_mirror.py
new file mode 100644
index 0000000..a4a9782
--- /dev/null
+++ b/tests/test_sparse_mirror.py
@@ -0,0 +1,130 @@
+"""Sparse VRAM mirrors (RX_VK_MIRROR_SPARSE; gpu/vk/sparse_mirror.h, no game/GPU required): the header's block rules
+compiled and run, and checks that vk_memory.cpp uses them where a block with no memory could be reached: the page table
+points such blocks at guest memory, a binding that reaches one where a game pool is is served from guest memory and asks
+for it (one whose blocks with none are all outside every game pool is served from the mirror), copies from or into a
+mirror leave such blocks out, a write-back never reads one, and a freed mirror's blocks go with it. On by default
+(RX_VK_MIRROR_SPARSE=0: off), and off where the device lacks strict sparse residency for buffers.
+
+python -I -B tests/test_sparse_mirror.py [--cxx g++]
+"""
+import argparse
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, marker):
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def need(text, needles, where):
+    for n in needles:
+        if n not in text:
+            raise SystemExit(f"vk_memory.cpp: {where} no longer has: {n}")
+
+
+def check_source():
+    mem = (ROOT / "gpu/vk/vk_memory.cpp").read_text(encoding="utf-8")
+    # (on by default: unset is on, =0 / off / false / no off; never where the device can't)
+    need(block(mem, "bool mirror_sparse_on()"), ['getenv("RX_VK_MIRROR_SPARSE")', "const bool asked = !v || !env_value_off(v);",
+                                                 "residencyNonResidentStrict", "sparseResidencyBuffer", "return asked && can;"],
+         "mirror_sparse_on()")
+    make = block(mem, "bool mirror_make(Pool& pool) {")
+    need(make, ["sparse_mirror::live_blocks(p->lo, p->hi", "sparse_fill(*p, sparse_buf, sparse_req, live)",
+                "sparse_table(*p, ma, 0, p->has.size())", "sparse_mirror::clip(", "sparse_mirror::cut_src(out, pending)", "cap_pages_over(*p, p->lo, p->hi, over)",
+                "mirror_bytes += mirror_size(*p);"], "mirror_make()")
+    # (the whole copy from guest memory: only the blocks with memory when the mirror is sparse)
+    if make.index("if (p->sparse) {   // (the blocks with memory)") > make.index("vkCmdCopyBuffer(upload_command_buffer(), p->buffer, p->mirror, 1, &all)"):
+        raise SystemExit("vk_memory.cpp: mirror_make() copies the whole pool before it looks whether the mirror is sparse")
+    bind = block(mem, "BufferRef gpu_buffer_bind(uint64_t gpu, uint64_t size, bool written) {")
+    fast = bind[:bind.index("ParLock plk;")]
+    need(fast, ["sparse_has(*p, off, size)", "sparse_touch(*p, off, size);"], "gpu_buffer_bind()'s path without the lock")
+    slow = bind[bind.index("ParLock plk;"):]
+    at = slow.index("if (p->sparse && !sparse_has(*p, off, size)) {")
+    if not at < slow.index("mirror_sync(*p);") < slow.index("return remember({p->mirror, off, size, 0});"):
+        raise SystemExit("vk_memory.cpp: gpu_buffer_bind() can hand out a sparse mirror's block with no memory")
+    # (a binding whose blocks with no memory are all outside every game pool: served from the mirror, nothing wanted; the
+    # others from guest memory, below)
+    past = slow.index("if (p->sparse && !sparse_has(*p, off, size) && sparse_gaps_outside_pools(*p, off, size)) {")
+    if not past < at < slow.index("mirror_sync(*p);"):
+        raise SystemExit("vk_memory.cpp: gpu_buffer_bind() no longer serves a binding past every game pool from the mirror first")
+    if "sparse_want(" in slow[past:at]:
+        raise SystemExit("vk_memory.cpp: gpu_buffer_bind() wants blocks no game pool is in")
+    need(block(mem, "bool sparse_gaps_outside_pools("), ["sparse_mirror::live_blocks(lo, hi, b, guest_pools.begin(), guest_pools.end(), live)",
+                                                       "if (!block_has(p, i) && i - a < live.size() && live[i - a]) return false;"],
+         "sparse_gaps_outside_pools()")
+    need(slow[at:slow.index("mirror_sync(*p);")], ["sparse_want(*p, off, size);", "note_direct_write(*p, off, size)",
+                                                  "p->refill.push_back(",
+                                                  "shadow_forget(", "return remember({p->buffer, off, size, 0});"],
+         "gpu_buffer_bind()'s block with no memory")
+    grow = block(mem, "void sparse_grow_all(const std::vector<Pool*>& pools) {")
+    need(grow, ["sparse_bind_infos(infos)", "full_barrier(up,", "vkCmdCopyBuffer(up, p.buffer, p.mirror", "cap_pages_over(p,",
+                "sparse_table(p, ma, i, i + 1)", "shadow_forget(p, c.dstOffset, c.size)", "p.released[i] = nullptr;", "++p.release_gen[i];",
+                "mirror_bytes + taking + b > mirror_budget()", "p.refill.clear();",
+                "vkCmdCopyBuffer(up, buf, p.mirror"], "sparse_grow_all()")
+    if not grow.index("vkCmdCopyBuffer(up, p.buffer, p.mirror") < grow.index("sparse_table(p, ma, i, i + 1)"):
