+        occ_pending.push_back({0, 0, s.occ_first, s.occ_next - s.occ_first, value, rec_part_next});
+    s.occ_on = s.occ_next < s.occ_limit;
+    s.occ_first = s.occ_next;
+    s.occ_overflow = false;
+    s.occ_color = false;
