+        bool all = true;
+        for (uint64_t i = o.first - first; i < o.first - first + o.n && all; i++) all = got[2 * i + 1] != 0;
+        if (!all && !(o.value && done >= o.value)) break;   // (still on the GPU: it and those after it wait)
+        ready++;
+    }
