@@ -0,0 +1,142 @@
+"""The write marks' collection finds the same pages 256 marks a step as 32 (host/rx_backend.c collect_in).
+
+collect_in and its 256-mark test are cut out of the source and compiled against a small mark array. For random marks
+and ranges (aligned or not, short, empty, past the guest's end, past the array's end) the pages found, their order and
+the marks left must be those of a plain walk, with the wide step on and with HOS_COLLECT_WIDE=0. The fixture also
+checks that the wide step is really taken (a range of 4096 clear marks is walked in 16 steps).
+
+python -I -B tests/test_collect_wide.py [--cc gcc]
+"""
+import argparse
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+FIXTURE = r"""
+#define _POSIX_C_SOURCE 200112L
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define A64_DIRTY_PAGES (1ull << 16)
+static uint8_t a64_dirty[A64_DIRTY_PAGES];
+static uint64_t guest_size = A64_DIRTY_PAGES << 12;
+static uint64_t hos_guest_size(void) { return guest_size; }
+static int clear_calls;
+#define memcpy(d, s, n) (clear_calls += (n) == 256, memcpy(d, s, n))
+
+@MARKS_CLEAR@
+@COLLECT_IN@
+
+#undef memcpy
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint64_t rnd(void) {
+    rng ^= rng << 13, rng ^= rng >> 7, rng ^= rng << 17;
+    return rng;
+}
+
+/* (the plain walk: every page of every range, in order) */
+static size_t plain(const uint64_t (*ranges)[2], int n, const uint8_t *marks, uint8_t *left, uint32_t *out) {
+    size_t k = 0;
+    memcpy(left, marks, A64_DIRTY_PAGES);
+    for (int r = 0; r < n; r++) {
+        const uint64_t hi = ranges[r][1] < guest_size ? ranges[r][1] : guest_size;
+        uint64_t p1 = (hi + 4095) >> 12;
+        if (p1 > A64_DIRTY_PAGES) p1 = A64_DIRTY_PAGES;
+        for (uint64_t p = ranges[r][0] >> 12; p < p1; p++)
+            if (left[p]) left[p] = 0, out[k++] = (uint32_t)p;
+    }
+    return k;
+}
+
+int main(int argc, char **argv) {
+    const int want_wide = argc > 1 && argv[1][0] == '1';
+    static uint8_t marks[A64_DIRTY_PAGES], left[A64_DIRTY_PAGES];
+    static uint32_t expect[A64_DIRTY_PAGES];
+    static uint64_t ranges[64][2];
+    for (int round = 0; round < 400; round++) {
+        memset(marks, 0, sizeof marks);
+        const int density = round % 8;   /* (0: no mark at all; then sparse to dense, some in clusters) */
+        const uint64_t count = density == 0 ? 0 : (1ull << (density * 2));
+        for (uint64_t i = 0; i < count; i++) {
+            const uint64_t at = rnd() % A64_DIRTY_PAGES;
+            marks[at] = 1;
+            if (density == 5) marks[(at + 1) % A64_DIRTY_PAGES] = marks[(at + 255) % A64_DIRTY_PAGES] = 1;
+        }
+        if (round % 5 == 1) marks[255] = marks[256] = marks[511] = marks[A64_DIRTY_PAGES - 1] = 1;   /* (the steps' edges) */
+        guest_size = round % 7 == 3 ? (rnd() % A64_DIRTY_PAGES) << 12 | (rnd() & 4095) : A64_DIRTY_PAGES << 12;
+        int n = (int)(rnd() % 12);
+        uint64_t at = rnd() % 4096;
+        for (int r = 0; r < n; r++) {   /* (sorted, disjoint, as hos_gpu_guest_ranges gives them) */
+            const uint64_t len = round % 3 == 0 ? rnd() % 300 : rnd() % 40000;
+            ranges[r][0] = at << 12 | (round % 2 ? rnd() & 4095 : 0);
+            ranges[r][1] = (at + len) << 12 | (round % 2 ? rnd() & 4095 : 0);
+            if (ranges[r][1] < ranges[r][0]) ranges[r][1] = ranges[r][0];
+            at += len + 1 + rnd() % 600;
+            if (round % 11 == 7 && r == n - 1) ranges[r][1] = (A64_DIRTY_PAGES + 5000) << 12;   /* (past the array) */
+        }
+        const size_t k = plain(ranges, n, marks, left, expect);
+        memcpy(a64_dirty, marks, sizeof marks);
+        uint32_t *pages = 0;
+        const int64_t got = collect_in(ranges, n, &pages);
+        if ((size_t)got != k || (k && memcmp(pages, expect, k * sizeof *pages)) || memcmp(a64_dirty, left, sizeof left)) {
+            printf("round %d: %lld pages found, %zu expected, or other pages, or other marks left\n", round, (long long)got, k);
+            return 1;
+        }
+        free(pages);
+    }
+    /* (the wide step is taken: 4096 clear marks in 16 steps; and not with the switch off) */
+    memset(a64_dirty, 0, sizeof a64_dirty);
+    guest_size = A64_DIRTY_PAGES << 12;
+    ranges[0][0] = 0, ranges[0][1] = 4096ull << 12;
+    uint32_t *pages = 0;
+    clear_calls = 0;
+    if (collect_in(ranges, 1, &pages) != 0) return 1;
+    free(pages);
+    if (clear_calls != (want_wide ? 16 : 0)) {
+        printf("4096 clear marks: %d steps of 256, %d expected\n", clear_calls, want_wide ? 16 : 0);
+        return 1;
+    }
+    return 0;
+}
+"""
+
+
+def block(text, marker):
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--cc", default="gcc")
+    a = p.parse_args()
+    src = (ROOT / "host" / "rx_backend.c").read_text(encoding="utf-8")
+    fixture = (FIXTURE.replace("@MARKS_CLEAR@", block(src, "static inline int marks_clear_256("))
+               .replace("@COLLECT_IN@", block(src, "static int64_t collect_in(")))
+    with tempfile.TemporaryDirectory(prefix="collect-wide-") as tmp:
+        c = Path(tmp) / "fixture.c"
+        exe = Path(tmp) / "fixture"
+        c.write_text(fixture, encoding="utf-8")
+        subprocess.run([a.cc, "-std=c11", "-O1", "-Wall", "-Wextra", "-Werror", str(c), "-o", str(exe)], check=True)
+        for wide in ("1", "0"):
+            env = dict(os.environ)
+            env.pop("HOS_COLLECT_WIDE", None)
+            if wide == "0":
+                env["HOS_COLLECT_WIDE"] = "0"
+            subprocess.run([str(exe), wide], check=True, env=env)
+    print("ok: the same pages 256 marks a step as 32")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_commit_limit.py b/tests/test_commit_limit.py
new file mode 100644
index 0000000..bccff09
--- /dev/null
+++ b/tests/test_commit_limit.py
@@ -0,0 +1,84 @@
+"""Windows' commit limit (RAM plus the page file). Every VRAM block is charged to the process's commit, as the guest's memory is: a
+run held private commit at the VRAM blocks plus ~21 GB the whole way, and a 16 GB PC with a fixed 32 GB page file reached its 47.9 GB
+limit at 33.9 GB of its own. A guest commit then failed while an area loaded and the game's next write there crashed it.
+
+Checked here:
+- the textures' budget has a commit rule: below RX_VK_COMMIT_RESERVE_MB of headroom (GlobalMemoryStatusEx's ullAvailPageFile
+  and what the page files can still grow by, tests/test_commit_room.py; Windows only) the shortfall comes off the budget and
+  the rule's budget, as the driver's limit's excess does;
+- hos_commit and the first-touch handler wait at the commit limit (1455) and commit again before they give up, and they log a
+  failure the same way (commit_refused: the out-of-memory notice).
+- the first-touch handler tries a page another thread committed again on Windows only (#ifdef _WIN32): on Linux every fault in
+  the guest window would be retried forever instead of reaching the crash report.
+python -I -B tests/test_commit_limit.py
+"""
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, head):
+    at = text.find(head)
+    if at < 0:
+        raise SystemExit("FAIL: not found: " + head)
+    depth, i = 0, text.index("{", at)
+    for j in range(i, len(text)):
+        depth += {"{": 1, "}": -1}.get(text[j], 0)
+        if depth == 0:
+            return text[at:j + 1]
+    raise SystemExit("FAIL: unbalanced: " + head)
+
+
+def main():
+    tex = (ROOT / "gpu" / "vk" / "vk_texture.cpp").read_text(encoding="utf-8")
+    head = block(tex, "static bool commit_headroom(uint64_t* free_bytes)")
+    if "ullAvailPageFile" not in head or "#if defined(_WIN32)" not in head:
+        raise SystemExit("FAIL: commit_headroom does not read GlobalMemoryStatusEx's ullAvailPageFile on Windows only")
+    reserve = block(tex, "static uint64_t commit_reserve()")
+    if "RX_VK_COMMIT_RESERVE_MB" not in reserve or "2560ull << 20" not in reserve:
+        raise SystemExit("FAIL: commit_reserve is not RX_VK_COMMIT_RESERVE_MB with a 2560 MB default")
+    rule = re.search(r"if \(reserve && commit_headroom\(&commit_free\) && commit_free < reserve\) \{(.*?)\n        \}", tex, re.S)
+    if not rule:
+        raise SystemExit("FAIL: the textures' budget has no commit rule")
+    body = rule.group(1)
+    for need in ("const uint64_t over = reserve - commit_free;",
+                 "budget = std::min(budget, total_bytes > over ? total_bytes - over : 0);",
+                 "rule_budget = std::min(rule_budget, total_bytes > over ? total_bytes - over : 0);"):
+        if need not in body:
+            raise SystemExit("FAIL: the commit rule lacks: " + need)
+    # (the rule sits before the excess's eviction target is worked out, which reads rule_budget)
+    if tex.find("commit_headroom(&commit_free)") > tex.find("vram_compact::rule_target(total_bytes, size_budget, rule_budget)"):
+        raise SystemExit("FAIL: the commit rule comes after rule_target reads rule_budget")
+
+    glue = (ROOT / "host" / "mkw_glue.c").read_text(encoding="utf-8")
+    wait = block(glue, "static int commit_wait(void *p, SIZE_T size)")
+    if "Sleep(50)" not in wait or "ERROR_COMMITMENT_LIMIT" not in wait or "i < 100" not in wait:
+        raise SystemExit("FAIL: commit_wait does not retry for up to 5 s while the limit refuses")
+    commit = block(glue, "int hos_commit(uint64_t addr, uint64_t size)")
+    if "err == ERROR_COMMITMENT_LIMIT && commit_wait(" not in commit or "commit_refused(" not in commit:
+        raise SystemExit("FAIL: hos_commit does not wait at the commit limit before it reports the failure")
+    touch = block(glue, "static LONG CALLBACK commit_on_touch(EXCEPTION_POINTERS *info)")
+    if "err == ERROR_COMMITMENT_LIMIT && commit_wait(" not in touch or "commit_refused(" not in touch:
+        raise SystemExit("FAIL: the first-touch handler does not wait at the commit limit")
+    # (the retry of a page another thread committed is Windows' only: on Linux the VirtualQuery stand-in calls every guest page
+    # committed and read-write and the signal handler never sets 8, so every fault in the window would be tried again forever)
+    retry = "if (mbi.State == MEM_COMMIT && mbi.Protect == PAGE_READWRITE && rec->ExceptionInformation[0] != 8)"
+    if touch.count(retry) != 1:
+        raise SystemExit("FAIL: the first-touch handler does not retry a page another thread committed (not an execute fault)")
+    head, tail = touch[:touch.index(retry)], touch[touch.index(retry):]
+    opened = head.rfind("#ifdef _WIN32")
+    if opened < 0 or any(d in head[opened:] for d in ("#endif", "#else", "#elif")) or "#endif" not in tail \
+            or not 0 <= tail.find("return EXCEPTION_CONTINUE_EXECUTION;") < tail.index("#endif") \
+            or any(d in tail[:tail.index("#endif")] for d in ("#else", "#elif")):
+        raise SystemExit("FAIL: the first-touch handler's retry of a committed page is not under #ifdef _WIN32")
+    if "hos_commit(" in touch:
+        raise SystemExit("FAIL: the first-touch handler calls hos_commit, which would wait a second time")
+    refused = block(glue, "static void commit_refused(uint64_t lo, uint64_t size, DWORD err)")
+    if "hos_out_of_memory_box" not in refused:
+        raise SystemExit("FAIL: commit_refused does not show the out-of-memory notice")
+    print("PASS: the textures give commit back near the limit, and a commit at the limit waits for it before it fails")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_commit_room.cpp b/tests/test_commit_room.cpp
new file mode 100644
index 0000000..8146807
--- /dev/null
+++ b/tests/test_commit_room.cpp
@@ -0,0 +1,136 @@
+// The commit Windows still has room for (gpu/vk/commit_room.h): tests/test_commit_room.py compiles and runs this.
+#include "../gpu/vk/commit_room.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::printf("FAIL line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+namespace {
+const uint64_t MB = 1ull << 20, GB = 1ull << 30, kPage = 4096;
+using commit_room::PageFile;
+
+/// The textures' budget after the commit rule (vk_texture.cpp): below the reserve the shortfall comes off what they hold
+uint64_t budget_after(uint64_t textures, uint64_t reserve, uint64_t room) {
+    return room < reserve ? (textures > reserve - room ? textures - (reserve - room) : 0) : textures;
+}
+
+/// What SystemPageFileInformationEx writes: a record, then its name, the next record 8-aligned after it
+struct Query {
+    alignas(16) unsigned char buf[4096] = {};
+    size_t len = 0, last = 0;
+    void add(uint32_t total, uint32_t min_size, uint32_t max_size, const char16_t* name, bool name_inside = true) {
+        if (len) {
+            commit_room::Record prev;
+            std::memcpy(&prev, buf + last, sizeof prev);
+            prev.next = (uint32_t)(len - last);
+            std::memcpy(buf + last, &prev, sizeof prev);
+        }
+        size_t chars = 0;
+        while (name[chars]) chars++;
+        commit_room::Record r{};
+        r.total = total, r.in_use = total / 2, r.peak = total, r.min_size = min_size, r.max_size = max_size;
+        r.name_bytes = (uint16_t)(chars * 2), r.name_room = (uint16_t)(chars * 2 + 2);
+        r.name = name_inside ? (uint64_t)(uintptr_t)(buf + len + sizeof r) : (uint64_t)(uintptr_t)name;
+        std::memcpy(buf + len, &r, sizeof r);
+        std::memcpy(buf + len + sizeof r, name, chars * 2 + 2);
+        last = len;
+        len = (len + sizeof r + chars * 2 + 2 + 7) & ~(size_t)7;
+    }
+};
+}
+
+int main() {
+    using namespace commit_room;
+    const auto free_100 = [](char) -> uint64_t { return 100 * GB; };
+
+    // (a file Windows manages on a 32 GB PC: 2 GB now, up to 96 GB, 100 GB free on its drive)
+    const PageFile managed{2 * GB, 96 * GB, 'C'};
+    CHECK(growth(&managed, 1, free_100) == 94 * GB);
+    // (no further than the drive has free)
+    CHECK(growth(&managed, 1, [](char) -> uint64_t { return 10 * GB; }) == 10 * GB);
+    CHECK(growth(&managed, 1, [](char) -> uint64_t { return 0; }) == 0);
+    // (a file of a fixed size, or one at its maximum, or above it: nothing)
+    const PageFile fixed{16 * GB, 16 * GB, 'C'}, above{20 * GB, 16 * GB, 'C'};
+    CHECK(growth(&fixed, 1, free_100) == 0);
+    CHECK(growth(&above, 1, free_100) == 0);
+    // (a file whose drive is not known: nothing, and its drive is not asked for)
+    const PageFile unknown{2 * GB, 96 * GB, 0}, odd{2 * GB, 96 * GB, '?'};
+    int asked = 0;
+    const auto counting = [&](char) -> uint64_t { asked++; return 100 * GB; };
+    CHECK(growth(&unknown, 1, counting) == 0 && growth(&odd, 1, counting) == 0 && asked == 0);
+    CHECK(growth(nullptr, 0, counting) == 0 && asked == 0);
+    // (two files on one drive share its free space, which is read once; a file on another drive has its own)
+    const PageFile two[] = {{2 * GB, 8 * GB, 'C'}, {1 * GB, 9 * GB, 'C'}, {1 * GB, 4 * GB, 'D'}};
+    asked = 0;
+    CHECK(growth(two, 2, [&](char) -> uint64_t { asked++; return 10 * GB; }) == 10 * GB && asked == 1);
+    CHECK(growth(two, 3, [](char d) -> uint64_t { return d == 'C' ? 10 * GB : 1 * GB; }) == 11 * GB);
+    CHECK(growth(two, 3, free_100) == 6 * GB + 8 * GB + 3 * GB);
+    // (the sum does not wrap)
+    const PageFile huge[] = {{0, UINT64_MAX, 'C'}, {0, UINT64_MAX, 'D'}};
+    CHECK(growth(huge, 2, [](char) -> uint64_t { return UINT64_MAX; }) == UINT64_MAX);
+    CHECK(headroom(UINT64_MAX - 5, 10) == UINT64_MAX && headroom(3 * GB, 0) == 3 * GB && headroom(1 * GB, 94 * GB) == 95 * GB);
+
+    // (the growth is read only below the reserve, with the rule on and the count not switched off)
+    CHECK(wants_growth(1 * GB, 2560 * MB, true) && !wants_growth(2560 * MB, 2560 * MB, true) && !wants_growth(8 * GB, 2560 * MB, true));
+    CHECK(!wants_growth(1 * GB, 2560 * MB, false) && !wants_growth(0, 0, true));
+
+    // (the reported run: 32 GB, a page file of 2 GB at the start that Windows grew; 2,503 MB of textures with 370 MB left under
+    // the limit of the moment were cut to 313 MB, and with 28 MB left a cache goes to 0. With the growth counted they stay)
+    const uint64_t reserve = 2560 * MB;
+    CHECK(budget_after(2503 * MB, reserve, headroom(370 * MB, 0)) == 313 * MB);
+    CHECK(budget_after(2234 * MB, reserve, headroom(28 * MB, 0)) == 0);
+    const PageFile grown{14 * GB, 96 * GB, 'C'};
+    CHECK(budget_after(2503 * MB, reserve, headroom(370 * MB, growth(&grown, 1, free_100))) == 2503 * MB);
+    // (a page file at its maximum, or a full drive: the rule acts as before)
+    CHECK(budget_after(2503 * MB, reserve, headroom(370 * MB, growth(&fixed, 1, free_100))) == 313 * MB);
+    CHECK(budget_after(2503 * MB, reserve, headroom(370 * MB, growth(&grown, 1, [](char) -> uint64_t { return 0; }))) == 313 * MB);
+    // (what is left to grow by is less than the shortfall: only the rest comes off)
+    const PageFile nearly{95 * GB, 96 * GB, 'C'};
+    CHECK(budget_after(2503 * MB, reserve, headroom(370 * MB, growth(&nearly, 1, free_100))) == 2503 * MB - (2560 - 370 - 1024) * MB);
+
+    // (the drive in a page file's name)
+    CHECK(drive_of(u"\\??\\C:\\pagefile.sys", 19) == 'C' && drive_of(u"\\??\\d:\\pagefile.sys", 19) == 'D');
+    CHECK(drive_of(u"\\Device\\HarddiskVolume3\\pagefile.sys", 36) == 0 && drive_of(u"", 0) == 0 && drive_of(u":", 1) == 0);
+    CHECK(drive_of(u"\\??\\C:", 5) == 0 && drive_of(u"\\??\\C:", 6) == 'C' && drive_of(u"1:\\x", 4) == 0);
+
+    // (the query's records: sizes in pages, names inside the buffer)
+    Query q;
+    q.add(512 * 1024, 512 * 1024, 24 * 1024 * 1024, u"\\??\\C:\\pagefile.sys");            // (2 GB now, 96 GB at most)
+    q.add(256 * 1024, 256 * 1024, 256 * 1024, u"\\??\\E:\\pagefile.sys");                   // (1 GB, fixed)
+    PageFile out[4];
+    CHECK(page_files(q.buf, q.len, kPage, out, 4) == 2);
+    CHECK(out[0].size == 2 * GB && out[0].max_size == 96 * GB && out[0].drive == 'C');
+    CHECK(out[1].size == 1 * GB && out[1].max_size == 1 * GB && out[1].drive == 'E');
+    CHECK(growth(out, 2, free_100) == 94 * GB);
+    CHECK(page_files(q.buf, q.len, kPage, out, 1) == 1);
+    // (nothing written, or less than a record: no file)
+    CHECK(page_files(q.buf, 0, kPage, out, 4) == 0 && page_files(q.buf, sizeof(Record) - 1, kPage, out, 4) == 0);
+    // (a buffer cut inside the second record: the first alone; its name, now past the end, loses the drive only if cut too)
+    const size_t second = q.last;
+    CHECK(page_files(q.buf, second + 8, kPage, out, 4) == 1 && out[0].drive == 'C');
+    CHECK(page_files(q.buf, sizeof(Record) + 4, kPage, out, 4) == 1 && out[0].drive == 0 && out[0].max_size == 96 * GB);
+    // (a name outside the buffer is not read: the file has no drive and counts for nothing)
+    Query outside;
+    outside.add(512 * 1024, 0, 24 * 1024 * 1024, u"\\??\\C:\\pagefile.sys", false);
+    CHECK(page_files(outside.buf, outside.len, kPage, out, 4) == 1 && out[0].drive == 0 && growth(out, 1, free_100) == 0);
+    // (a next offset that points back into the record, or past the end, ends the list)
+    Query loop;
+    loop.add(1, 1, 2, u"\\??\\C:\\pagefile.sys");
+    loop.add(1, 1, 2, u"\\??\\D:\\pagefile.sys");
+    Record first;
+    std::memcpy(&first, loop.buf, sizeof first);
+    first.next = 8;
+    std::memcpy(loop.buf, &first, sizeof first);
+    CHECK(page_files(loop.buf, loop.len, kPage, out, 4) == 1);
+    first.next = (uint32_t)loop.len + 64;
+    std::memcpy(loop.buf, &first, sizeof first);
+    CHECK(page_files(loop.buf, loop.len, kPage, out, 4) == 1);
+    first.next = (uint32_t)loop.len - 8;   // (a record that would start inside the buffer but not fit)
+    std::memcpy(loop.buf, &first, sizeof first);
+    CHECK(page_files(loop.buf, loop.len, kPage, out, 4) == 1);
+
+    std::printf("PASS: what the page files can grow by counts as commit room, and the query's records are read inside their buffer\n");
+    return 0;
+}
diff --git a/tests/test_commit_room.py b/tests/test_commit_room.py
new file mode 100644
index 0000000..df0d90f
--- /dev/null
+++ b/tests/test_commit_room.py
@@ -0,0 +1,79 @@
+"""What the page files can still grow by counts as room under Windows' commit limit.
+
+The textures' budget gives commit back below RX_VK_COMMIT_RESERVE_MB of headroom (tests/test_commit_limit.py). The headroom was
+GlobalMemoryStatusEx's ullAvailPageFile alone: the limit as it is now, RAM plus the page files at their size of the moment. A
+page file Windows manages grows as the commit nears that limit. A 32 GB PC with a 2 GB page file at the start (issue 336)
+played 90 minutes with 0.3 to 2.5 GB left under the limit of the moment while Windows raised it by more than 12 GB and refused
+no commit; the rule cut the textures' budget the whole time, to 0 at its lowest, and the textures went black and were made
+again. The rule (gpu/vk/commit_room.h) is compiled and run: the growth of each file up to its maximum and its drive's free
+space, the reported run's numbers, and the reading of NtQuerySystemInformation's records inside their buffer. vk_texture.cpp is
+checked to use it. No GPU or game.
+
+python -I -B tests/test_commit_room.py [--cxx g++]
+"""
+import argparse
+import subprocess
+import tempfile
+from pathlib import Path
+
+RUN_ALL_ARGS = ["--cxx", "{cxx}"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, marker):
+    start = text.index(marker)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def need(where, text, needles):
+    for needle in needles:
+        if needle not in text:
+            raise SystemExit(where + " no longer has: " + needle)
+
+
+def check_source():
+    tex = (ROOT / "gpu/vk/vk_texture.cpp").read_text(encoding="utf-8")
+    need("vk_texture.cpp", tex, ['#include "commit_room.h"'])
+    # (the headroom is what is left under the limit now and, below the reserve, what the page files can grow by)
+    head = block(tex, "static bool commit_headroom(uint64_t* free_bytes)")
+    need("vk_texture.cpp: commit_headroom()", head,
+         ['getenv("RX_VK_COMMIT_GROWTH")',
+          "if (commit_room::wants_growth(m.ullAvailPageFile, commit_reserve(), counted)) {",
+          "grow = page_file_growth();",
+          "*free_bytes = commit_room::headroom(m.ullAvailPageFile, grow);"])
+    # (the growth comes from the page files' own sizes and maximums and their drives' free space, read at most once a second,
+    # and is 0 where the query fails)
+    grow = block(tex, "static uint64_t page_file_growth()")
+    need("vk_texture.cpp: page_file_growth()", grow,
+         ["if (at && now - at < 1000) return value;",
+          '"NtQuerySystemInformation"',
+          "if (!query || query(0x90, buf, sizeof buf, &len) < 0 || len > sizeof buf) return 0;",
+          "commit_room::page_files(buf, len, si.dwPageSize, files, 16)",
+          "value = commit_room::growth(files, n,",
+          "GetDiskFreeSpaceExW(root, nullptr, nullptr, &free_bytes) ? free_bytes.QuadPart : 0"])
+    if not tex.index("static uint64_t page_file_growth()") < tex.index("static bool commit_headroom(uint64_t* free_bytes)"):
+        raise SystemExit("vk_texture.cpp: page_file_growth() is no longer defined before commit_headroom()")
+    docs = (ROOT / "docs/development.md").read_text(encoding="utf-8")
+    need("docs/development.md", docs, ["`RX_VK_COMMIT_GROWTH=0`"])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cxx", default="g++")
+    args = parser.parse_args()
+    check_source()
+    with tempfile.TemporaryDirectory(prefix="commit-room-") as tmp:
+        exe = Path(tmp) / "commit-room"
+        subprocess.run([args.cxx, "-std=c++20", "-Wall", "-Wextra", "-Werror", str(ROOT / "tests/test_commit_room.cpp"), "-o",
+                        str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+
+
+if __name__ == "__main__":
+    main()
