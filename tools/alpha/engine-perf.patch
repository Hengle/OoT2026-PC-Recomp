+                if (w == ~0u) { printf("%zu %zu %zu: not kept\n", a, b, c); return 1; }
+                size_t x = 99, y = 99, z = 99;
+                desc_counts_unpack(w, &x, &y, &z);
+                if (x != a || y != b || z != c) { printf("%zu %zu %zu came back %zu %zu %zu\n", a, b, c, x, y, z); return 1; }
+            }
